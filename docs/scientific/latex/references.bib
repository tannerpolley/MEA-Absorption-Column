@article{ermatchkovSolubilityCarbonDioxide2006,
  title = {Solubility of {{Carbon Dioxide}} in {{Aqueous Solutions}} of {{N-Methyldiethanolamine}} in the {{Low Gas Loading Region}}},
  author = {Ermatchkov, Viktor and {P{\'e}rez-Salado Kamps}, {\'A}lvaro and Maurer, Gerd},
  year = 2006,
  month = jul,
  journal = {Industrial \& Engineering Chemistry Research},
  volume = {45},
  number = {17},
  pages = {6081--6091},
  issn = {0888-5885},
  doi = {10.1021/ie0604270},
  urldate = {2026-08-17},
  abstract = {A headspace gas chromatography technique was applied to determine the solubility of carbon dioxide in aqueous solutions of 2,2`-methyliminodiethanol (N-methyldiethanolamine, MDEA) at low gas loadings (at stoichiometric molar ratios of carbon dioxide to MDEA between about 0.003 and 0.8). A temperature range T {$\approx$} 313-393 K was covered. The stoichiometric molality of MDEA in water amounted to about 2, 4, and 8 mol/(kg of water) (mass fraction of MDEA {$\approx$} 0.192, 0.323, and 0.488). The partial pressure of carbon dioxide was between about 0.1 and 70 kPa. A thermodynamic model for describing the vapor-liquid equilibrium (which applies Pitzer's molality-scale-based equation for describing the Gibbs excess energy of the aqueous phase) is revised and extended using the new data.},
  langid = {english}
}

@article{ermatchkovSolubilityCarbonDioxide2006a,
