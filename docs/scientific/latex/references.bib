  doi = {10.1109/WERC66199.2025.11143800},
  urldate = {2026-10-23},
  abstract = {Produced water (PW) from oil and gas operations poses a major disposal challenge in the Permian Basin due to high volumes and limited infrastructure. However, PW contains valuable elements, including calcium, which presents an opportunity for resource recovery. This study focuses on extracting calcium from PW brine by precipitating calcium carbonate (CaCO3), a compound with strong regional demand in construction, oil production, and emerging direct air capture technologies. After evaluating several treatment pathways, soda ash softening -- adding sodium carbonate (Na2CO3) to induce CaCO3 precipitation -- was selected based on solubility modeling and bench-scale testing. PHREEQC modeling guided experimental design, identifying optimal carbonate-to-calcium molar ratios. Jar tests were conducted on real PW samples across a range of Na2CO3 dosages, with resulting CaCO3 purities ranging from 80\% to 88\% as measured by Inductively Coupled Plasma Optical Emission Spectroscopy (ICP-OES). These purities meet market requirements for cement and drilling applications and suggest potential for further refinement in high-purity markets. The process is compatible with standard industrial equipment and integrates well with existing oilfield operations. Overall, soda ash softening demonstrates strong potential as a technically feasible and scalable method for reducing PW disposal volumes while recovering a useful product.},
  isbn = {979-8-3315-8594-5},
  keywords = {/unread,Ash,Atmospheric modeling,brine,brine mining,calcium carbonate,Calcium compounds,oil and gas,Oils,Permian Basin,produced water,Production,resource recovery,Sodium,Softening,Standards,Testing,Water resources,water scarcity,water softening}
}

