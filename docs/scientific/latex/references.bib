@article{rehnerModelingMixturesPCPSAFT2023,
  title = {Modeling {{Mixtures}} with {{PCP-SAFT}}: {{Insights}} from {{Large-Scale Parametrization}} and {{Group-Contribution Method}} for {{Binary Interaction Parameters}}},
  shorttitle = {Modeling {{Mixtures}} with {{PCP-SAFT}}},
  author = {Rehner, Philipp and Bardow, Andr{\'e} and Gross, Joachim},
  year = 2023,
  month = dec,
  journal = {International Journal of Thermophysics},
  volume = {44},
  number = {12},
  pages = {179},
  publisher = {{Springer Science and Business Media LLC}},
  issn = {0195-928X, 1572-9567},
  doi = {10.1007/s10765-023-03290-3},
  urldate = {2026-10-13},
  abstract = {Abstract                  Vapor/liquid equilibria of mixtures are of utmost importance in the design of chemical processes. Because of the combinatorial complexity of mixtures, the available experimental data are small when considering the large molecular space. To fill this knowledge gap, molecular equations of state like PCP-SAFT show promise due to their explicit consideration of intermolecular interactions that can be transferred to mixtures. In this work, we comprehensively assess and exploit PCP-SAFT for modeling phase equilibria of mixtures. First, we provide binary interaction parameters for 7861 binary systems for which pure-component parameters and experimental data are available. Bubble and dew point pressures are described with a median deviation of 2.3 \%. Secondly, we adjust a matrix of binary group/group interaction parameters for the homosegmented and heterosegmented group-contribution (GC) methods for PCP-SAFT. Among 1389 mixtures that can be described with the GC methods, the median deviation in bubble and dew point pressures are 6.4 \% for the homosegmented approach and 5.1 \% for the heterosegmented approach. The detailed analysis shows the importance of hydrogen bonds in mixtures of non-self-associating components with self-associating components. The parametrization is only possible by introducing a fast numerical method to calculate the derivative of bubble and dew point pressures with respect to arbitrarily many model parameters. The approach leverages reverse mode automatic differentiation (backpropagation), the same method used in machine learning to regress millions of model parameters to large datasets.},
  copyright = {https://creativecommons.org/licenses/by/4.0},
  langid = {english},
  keywords = {/unread}
}

@article{renHighlySelectiveExtraction2021a,
  title = {Highly Selective Extraction of Lithium Ions from Salt Lake Brines with Sodium Tetraphenylborate as Co-Extractant},
  author = {Ren, Zhongqi and Wei, Xiaoyu and Li, Rujie and Wang, Wanhang and Wang, Yangyang and Zhou, Zhiyong},
  year = 2021,
  month = aug,
  journal = {Separation and Purification Technology},
  volume = {269},
  pages = {118756},
  publisher = {Elsevier BV},
  issn = {1383-5866},
  doi = {10.1016/j.seppur.2021.118756},
  urldate = {2026-10-23},
  abstract = {It is very difficult to selectively extract lithium ions from high Mg/Li salt lake brine efficiently and environmentally. Among the conventional extraction system, FeCl3 as the co-extractant has the disadvantages of easy to loss and reducing stability of the organic phase. Therefore, a new co-extractant must be developed and applied for selective extraction of lithium ions. TBP was used as the extractant. According to the optimization of extraction conditions, NaBPh4 and CH2ClBr were selected as the suitable co-extractant and diluent. Under the optimal extraction conditions (molar ratio of NaBPh4 to Li+~=~2.0, TBP volume fraction~=~50\%, and R(O/A)~=~1.0), the one-stage extraction efficiency of Li+ and Li/Mg separation factor reached up to 87.65\% and 2260.71, respectively. Effects of washing and stripping conditions on washing and stripping performances were investigated too. Under optimal conditions of washing and stripping processes, the stripping efficiency of Li+ reached up to 98.84\% and Li2CO3 product could be directly obtained in the aqueous phase. Then ten continuous cycles of the whole extraction processes were performed and the results verified that the extraction system showed excellent extraction stability and reusability. The extraction mechanism was deeply studied by using simulation calculation on Materials Studio software and nuclear magnetic resonance characterization. The binding capacity of TBP to metal ions follows the sequence: Li+~{$>~$}Na+~{$>~$}K+~{$>~$}Mg2+. This proposed extraction technology not only avoids the use of acid and alkali, but also reduces the process flow, which has great research potential and industrialization value.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid = {english},
  keywords = {/unread,Co-extraction,Selective extraction,Separation factor,Sodium tetraphenylborate,Solvent extraction}
}

@article{renonLocalCompositionsThermodynamic1968,
  title = {Local Compositions in Thermodynamic Excess Functions for Liquid Mixtures},
  author = {Renon, Henri and Prausnitz, J. M.},
  year = 1968,
  month = jan,
  journal = {AIChE Journal},
  volume = {14},
  number = {1},
  pages = {135--144},
  publisher = {Wiley},
  issn = {0001-1541, 1547-5905},
  doi = {10.1002/aic.690140124},
  urldate = {2026-10-29},
  abstract = {Abstract                                      A critical discussion is given of the use of local compositions for representation of excess Gibbs energies of liquid mixtures. A new equation is derived, based on Scott's two-liquid model and on an assumption of nonrandomness similar to that used by Wilson. For the same activity coefficients at infinite dilution, the Gibbs energy of mixing is calculated with the new equation as well as the equations of van Laar, Wilson, and Heil; these four equations give similar results for mixtures of moderate nonideality but they differ appreciably for strongly nonideal systems, especially for those with limited miscibility. The new equation contains a nonrandomness parameter {$\alpha$}                    12                    which makes it applicable to a large variety of mixtures. By proper selection of {$\alpha$}                    12                    , the new equation gives an excellent representation of many types of liquid mixtures while other local composition equations appear to be limited to specific types. Consideration is given to prediction of ternary vapor-liquid and ternary liquid-liquid equilibria based on binary data alone.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english}
}

@article{Restrepo2021,
  title = {Design of an Absorption Tower for a Laboratory Scale {{CO2}} Capture Plant},
  author = {Restrepo, Valeria Rom{\'a}n and Meneses, Michel Alejandra Herrera and Toro, Santiago Builes},
  year = 2021,
  journal = {Universidad EAFIT},
  abstract = {Carbon dioxide (CO2) is the main greenhouse gas in the earth's atmosphere. The current concentration levels of CO2 in the atmosphere contribute to generate irreversible changes in the climate, sea level and the environment. Due to the highly industrialized economy, for today's society it will not be possible, in the mid-term, to stop these CO2 emissions without serious economic and social consequences. Therefore, it is necessary to implement several strategies to reduce CO2 emissions, for instance integrated CO2 capture systems that are efficient and economically viable. Strategies such as carbon capture and storage can used to reduce the impact of CO2 emissions on the global climate to an acceptable level. Reactive absorption with aqueous solutions of amines in an absorber/stripper loop is the most mature technology for CO2 capture from existing plants. Therefore, it is proposed to design an absorption tower at laboratory scale in stainless-steel due to its stability and resistance to corrosion for the capture of CO2 using monoethanolamine. This requires the assessment of the best model for describing an absorption tower at laboratory scale by comparing different models and simulations programs to determine the most appropriate one for design at laboratory scale. The model implemented in Python absorption tower design was chosen over the commercial simulators, resulting in a 10 mm Raschig ceramic ring packing, a CO2 removal rate of 80\%, an internal diameter of 21.7 mm and a packing height of 400 mm.},
  keywords = {MetadataHunter: No DOI}
}

@article{Rezaee2025,
  title = {Application of {{Response Surface Methodology}} for {{Selective Extraction}} of {{Lithium Using}} a {{Hydrophobic Deep Eutectic Solvent}}},
  author = {Rezaee, Mehran and Feyzi, Farzaneh and Javanshir, Shahrzad},
  year = 2025,
  month = jan,
  journal = {Industrial \& Engineering Chemistry Research},
  volume = {64},
  number = {4},
  pages = {2294--2308},
  publisher = {American Chemical Society},
  issn = {0888-5885},
  doi = {10.1021/acs.iecr.4c03496},
  urldate = {2026-05-08},
  abstract = {Lithium is a strategic element for energy storage. Extraction from surface water is a promising method for the purification of lithium. Synthetic model brines containing lithium and sodium ions were prepared for extraction experiments. A hydrophobic deep eutectic solvent (HDES) was synthesized using tetrabutylammonium chloride (TBAC) as the hydrogen bond acceptor (HBA) and decanoic acid (DA) as the hydrogen bond donor (HBD). Trioctylphosphine oxide (TOPO) was chosen as the coextractant. Fourier transform infrared (FT-IR) and 1H NMR analyses confirmed the physical interactions between the HBD and HBA. Response surface methodology was used to optimize the operational parameters for lithium extraction percentage and selectivity. The organic phase containing TBAC(1)/DA(2) and 10 wt \% of TOPO at T = 23.0 {$^\circ$}C and pH = 10.4 demonstrated the highest extraction performance. The optimized point yielded a selectivity of 4.41 and an extraction efficiency of 48.57\% for one stage of extraction. The ion exchange reaction between lithium and hydrogen in the deep eutectic solvent (DES) phase was confirmed by FT-IR spectroscopy. Five regeneration cycles revealed that the organic phase remained stable after the third cycle. The extraction efficiency of lithium ions from a model brine with the same composition as that of Iran's sources was 51.63\% compared to those of sodium, potassium, magnesium, and calcium ions, which were 9.97, 3.11, 4.38, and 2.29\%, respectively. The HDES synthesized in this study is cost-effective and biodegradable compared to other HDESs reported in the literature.}
}

@article{Rezaee2026,
  title = {Thermodynamic Modeling of Lithium Extraction from Synthetic Brine Using Deep Eutectic Solvents: {{A PC-SAFT}} Approach},
  shorttitle = {Thermodynamic Modeling of Lithium Extraction from Synthetic Brine Using Deep Eutectic Solvents},
  author = {Rezaee, Mehran and Feyzi, Farzaneh and Miri, Rohaldin},
  year = 2026,
  month = oct,
  journal = {Fluid Phase Equilibria},
  volume = {609},
  pages = {114737},
  issn = {0378-3812},
  doi = {10.1016/j.fluid.2026.114737},
  urldate = {2026-05-07},
  abstract = {Renewable energy sources are essential for mitigating global warming, with lithium-ion batteries serving as a key technology for effective energy storage in electric vehicles and grid-scale applications. This research investigates the thermodynamic modeling of lithium extraction from synthetic brine using a hydrophobic deep eutectic solvent (DES). The extraction process involves ion exchange between aqueous ions (Li{$^+$}, Na{$^+$}) and an organic phase containing DES (tetrabutylammonium chloride (TBAC) and Decanoic acid (DA) with 1:2 molar ratio) and Trioctylphosphine oxide (TOPO). Equilibrium reaction constants were calculated using Joback-Reid and Mostafa group contribution methods. Equilibrium calculations were performed using PC-SAFT and ePC-SAFT equations of state (EOS) for the organic phase and aqueous phase, respectively. EOS parameters for the DES and TOPO were derived from experimental density measurement data. Binary interaction parameters of the EOS, in the organic phase, were fitted to experimental equilibrium data. The average absolute relative deviation (AARD) for lithium extraction percentage and selectivity over sodium were 7.89 \% and 8.63 \%, respectively.},
  langid = {english},
  keywords = {Deep eutectic solvents,Density measurement,Lithium extraction,PC-SAFT equation of state,Thermodynamic modeling}
}

