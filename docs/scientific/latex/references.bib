@article{mackeyEstimatesLithiumMass2024,
  title = {Estimates of Lithium Mass Yields from Produced Water Sourced from the {{Devonian}}-Aged {{Marcellus Shale}}},
  author = {Mackey, Justin and Bain, Daniel J. and Lackey, Greg and Gardiner, James and Gulliver, Djuna and Kutchko, Barbara},
  year = 2024,
  month = apr,
  journal = {Scientific Reports},
  volume = {14},
  number = {1},
  pages = {8813},
  publisher = {{Springer Science and Business Media LLC}},
  issn = {2045-2322},
  doi = {10.1038/s41598-024-58887-x},
  urldate = {2026-10-19},
  abstract = {Abstract                                      Decarbonatization initiatives have rapidly increased the demand for lithium. This study uses public waste compliance reports and Monte Carlo approaches to estimate total lithium mass yields from produced water (PW) sourced from the Marcellus Shale in Pennsylvania (PA). Statewide, Marcellus Shale PW has substantial extractable lithium, however, concentrations, production volumes and extraction efficiencies vary between the northeast and southwest operating zones. Annual estimates suggest statewide lithium mass yields of approximately 1160 (95\% CI 1140--1180) metric tons (mt) per year. Production decline curve analysis on PW volumes reveal cumulative volumetric disparities between the northeast (median\,=\,2.89 X 10                    7                    L/10-year) and southwest (median\,=\,5.56\,\texttimes\,10                    7                    L/10-year) regions of the state, influencing lithium yield estimates of individual wells in southwest [2.90 (95\% CI 2.80--2.99) mt/10-year] and northeast [1.96 (CI 1.86--2.07) mt/10-year] PA. Moreover, Mg/Li mass ratios vary regionally, where NE PA are low Mg/Li fluids, having a median Mg/Li mass ratio of 5.39 (IQR, 2.66--7.26) and SW PA PW is higher with a median Mg/Li mass ratio of 17.8 (IQR, 14.3--20.7). These estimates indicate substantial lithium yields from Marcellus PW, though regional variability in chemistry and production may impact recovery efficiencies.},
  copyright = {https://creativecommons.org/licenses/by/4.0},
  langid = {english},
  keywords = {/unread}
}

@misc{madalynsblondesUSGeologicalSurvey,
  title = {U.{{S}}. {{Geological Survey National Produced Waters Geochemical Database}} (Ver. 3.0, {{December}} 2023)},
