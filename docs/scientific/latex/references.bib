@article{yangSystematicEvaluationParameterization2023a,
  title = {Systematic Evaluation of Parameterization Approaches for the {{ePPC-SAFT}} Model for Aqueous Alkali Halide Solutions},
  author = {Yang, Fufang and Ngo, Tri Dat and Roa Pinto, Juan Sebastian and Kontogeorgis, Georgios M. and {de Hemptinne}, Jean-Charles},
  year = 2023,
  month = jul,
  journal = {Fluid Phase Equilibria},
  volume = {570},
  pages = {113778},
  publisher = {Elsevier BV},
  issn = {0378-3812},
  doi = {10.1016/j.fluid.2023.113778},
  urldate = {2026-10-23},
  abstract = {This work presents an analysis of various electrolyte SAFT model approaches through a rigorous benchmarking on extensively collected and critically evaluated databases. The primitive mean spherical approximation (MSA) and the Born equation are used respectively for the long-range ion-ion and ion-solvent interactions. For the short range interactions either dispersion, or association, or both (full) are used. Doing so, state-of-the-art parameter sets are obtained for the ePPC-SAFT model. Physical consistency is enforced for the parameters in the regression. Efforts are made to reduce the number of adjustable parameters with minimum loss of accuracy. This is done by analyzing the physical indication of the parameters, parameter sensitivity analysis, parameter trends, and trial-and-error. The model and parameter sets accurately represent the mean ionic activity coefficient (MIAC), vapor-liquid equilibria, and density, and accurately predict the osmotic coefficient extrapolated to temperature and salt composition ranges beyond the range of the MIAC data used in the regression. The ion-specific association strategies are found to be approximately as accurate as the salt-specific strategies, and are more accurate than the ion-specific dispersion and full strategies. Contributions of the model terms to the MIAC are analyzed. Temperature-dependence of the MIAC is discussed. The ion-specific association strategies successfully predicts the opposite relative magnitudes of the cation and anion individual ion activity coefficient of the aqueous NaCl and KCl solutions. The information is not included in model parameterization, while all the salt-specific strategies and ion-specific dispersion and full strategies fail. We recommend including the Wertheim association for the short-range ion-ion and ion-solvent interactions, and parameterizing SAFT models in an ion-specific manner using physically consistent parameters.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid = {english},
  keywords = {/unread,Activity coefficient,Aqueous electrolyte solutions,Density,Equation of state,Vapor-liquid equilibria}
}

@article{yanLithiumExtractionSalt2026,
  title = {Lithium Extraction from Salt Lake Brines by {{HDBM-TBPO}} Synergistic System: {{Molecular}} Screening Based on Hammett Constant, Hydrophobicity and Steric Hindrance},
  shorttitle = {Lithium Extraction from Salt Lake Brines by {{HDBM-TBPO}} Synergistic System},
  author = {Yan, Bingqing and Fan, Wenbin and Jiang, Lizhi and Li, Huifang},
  year = 2026,
  month = nov,
  journal = {Desalination},
  volume = {638},
  pages = {120566},
  issn = {0011-9164},
  doi = {10.1016/j.desal.2026.120566},
  urldate = {2026-08-18},
  abstract = {As a core material of lithium-ion batteries, lithium is difficult to recover from salt lake brines because of complex procedures and excessive energy consumption. Herein, a variety of {$\beta$}-diketone extractants were screened by hydrophobicity ({$\pi$}) and Hammett substituent constant ({$\sigma$}) based on their electronic effects and Li+ chelating strength. Subsequently, various neutral organophosphorus synergists were evaluated based on the steric hindrance around the PO group, as lower steric hindrance facilitates axial coordination with the Li-chelate complex. Dibenzoylmethane (HDBM) and tributylphosphine oxide (TBPO) were identified as the optimal extractant and synergist, respectively. Under the optimized conditions, the Li+ extraction efficiency exceeded 99\%, with a Li/Na separation factor of 250. The loaded organic phase was effectively stripped by 0.2~mol/L HCl and regenerated by 0.02~mol/L Na2CO3. The system retained 99\% extraction efficiency after 11~cycles without emulsification, showing excellent reusability. Mechanistic investigations demonstrated that the extracted complex was Li{$\bullet$}2HDBM{$\bullet$}0.2TBPO, and the extraction was an enthalpy-driven process via chelation and coordination interactions. This synergistic system presents a promising and sustainable approach for lithium recovery from brines and aqueous resources.},
  keywords = {-diketone,HDBM-TBPO system,Lithium extraction,Salt Lake Brine,Synergistic Extraction}
}

@article{yaoRobustOptimizationFlexible2026,
  title = {Robust Optimization of Flexible Diafiltration Systems for Critical Mineral Separations},
  author = {Yao, Jason L. and Dougher, Molly and Lee, Andrew and Garciadiego, Alejandro and Tarka, Thomas J. and Dowling, Alexander W. and Gounaris, Chrysanthos E.},
  year = 2026,
  month = aug,
  journal = {Chemical Engineering Journal Advances},
  volume = {27},
  pages = {101282},
  issn = {2666-8211},
  doi = {10.1016/j.ceja.2026.101282},
  urldate = {2026-08-07},
  abstract = {Diafiltration membrane processes are a promising technology for recovering critical minerals and materials (CMMs), but they also face challenges in that actual system performance during operation can deviate from design specifications. This requires risk reduction methods to aid in the deployment of these processes, including leveraging modeling and accounting for uncertainty during the design phase. To mitigate risks associated with membrane performance uncertainties, we applied a robust optimization approach using PyROS software to generate designs that maintain system performance under uncertain membrane sieving and flux through the membrane. We specifically show how the traditional use of a mere deterministic process model fails to protect against such uncertainties, leading to unnecessary overdesigns in membrane area and recycle pumping capacity. In contrast, we find that membrane systems designed with robust optimization achieve higher feasibility guarantees across uncertain scenarios while maintaining costs that are relatively similar to their deterministic counterparts.},
  langid = {english},
  keywords = {Critical minerals separation,Nanofiltration,Nonlinear robust optimization,Process design under uncertainty,PyROS}
}

