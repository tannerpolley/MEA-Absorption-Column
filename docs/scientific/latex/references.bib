@phdthesis{Hilliard2008,
  title = {A {{Predictive Thermodynamic Model}} for an {{Aqueous Blend}} of {{Potassium Carbonate}}, {{Piperazine}}, and {{Monoethanolamine}} for {{Carbon Dioxide Capture}} from {{Flue Gas}}},
  author = {Hilliard, Marcus Douglas},
  year = 2008,
  eprint = {2152/3900},
  eprinttype = {hdl},
  abstract = {The Electrolyte Nonrandom Two-Liquid Activity Coefficient model in Aspen PlusTM 2006.5 was used to develop a rigorous and consistent thermodynamic representation for the base sub-component systems associated with aqueous combinations of K2CO3, KHCO3, MEA, and piperazine (PZ) in a mixed-solvent electrolyte system for the application of CO2 absorption/stripping from coal fired power plants. We developed a new vapor-liquid equilibrium apparatus to measure CO2, amine, and H2O vapor pressures at 40 and 60 o C. We found that the volatility of MEA and PZ can be approximated at 50 and 20 ppmv at 40 o C for any solvent composition studied in this work, over the CO2 partial pressure range from 0.01 to 0.1 kPa. Very few solvent compositions exhibited a greater differential capacity than 7 m MEA at 60 o C; specifically 11 m MEA, 3.5 x m MEA + 3.6 m PZ, 7 m MEA + 2 m PZ, 7 m MEA + 3.6 m PZ, and 5 m K+ + 7 m MEA + 3.6 m PZ. Piperazine exhibited a possible maximum differential capacity of 2.21 mole CO2/kg-H2O at a concentration of 7.3 m. At the Norwegian University of Science and Technology, Inna Kim determined the differential enthalpy of CO2 absorption for aqueous combinations of K2CO3, KHCO3, MEA, PZ, and CO2, based on a consistent experimental method developed for MEA, from 40 to 120 o C for use in this work. In addition, we developed a consistent method to measure the specific heat capacity for a number of similar solvent combinations. We found that the enthalpy of CO2 absorption increased with temperature because the apparent partial heat capacity of CO2 may be considered small. Finally, by using a differential scanning calorimeter, we determined the dissolution temperature for aqueous mixtures of unloaded piperazine, which inferred an effective operating range for solutions of concentrated piperazine, greater than 5 m PZ, over a loading range between 0.25 to 0.45 mole CO2/2{$\cdot$}mol PZ. Through unit cell x-ray diffraction, we were able to identify and characterize the presence of three solid phases (PZ{$\cdot$}6H2O, KHCO3, and K2PZ(COO)2) in aqueous mixture combinations of K2CO3, KHCO3, MEA, PZ, and CO2.},
  school = {The University of Texas at Austin},
  keywords = {topic:thermodynamics}
}

@article{hiragaMeasurementCorrelationHighPressure2018,
  title = {Measurement and {{Correlation}} of {{High-Pressure Densities}} and {{Atmospheric Viscosities}} of {{Ionic Liquids}}: 1-{{Butyl-1}}-Methylpyrrolidinium {{Bis}}(Trifluoromethylsulfonyl)Imide), 1-{{Allyl-3}}-Methylimidazolium {{Bis}}(Trifluoromethylsulfonyl)Imide, 1-{{Ethyl-3}}-Methylimidazolium {{Tetracyanoborate}}, and 1-{{Hexyl-3}}-Methylimidazolium {{Tetracyanoborate}}},
  shorttitle = {Measurement and {{Correlation}} of {{High-Pressure Densities}} and {{Atmospheric Viscosities}} of {{Ionic Liquids}}},
  author = {Hiraga, Yuya and Hagiwara, Saki and Sato, Yoshiyuki and Smith, Jr., Richard L.},
  year = 2018,
  month = jan,
  journal = {Journal of Chemical \& Engineering Data},
  volume = {63},
  number = {4},
  pages = {972--980},
  issn = {0021-9568},
  doi = {10.1021/acs.jced.7b00773},
  urldate = {2026-08-18},
  abstract = {Four ionic liquids, [bmpyr]\-[Tf2N] (1-butyl-1-methylpyrrolidinium bis\-(trifluoromethylsulfonyl)\-imide), [amim]\-[Tf2N] (1-allyl-3-methylimidazolium bis\-(trifluoromethylsulfonyl)\-imide), [emim]\-[TCB] (1-ethyl-3-methylimidazolium tetracyanoborate), and [hmim]\-[TCB] (1-hexyl-3-methylimidazolium tetracyanoborate), were studied. High-pressure densities were measured at pressures up to 200 MPa and at temperatures of 312-433 K. Densities and viscosities at atmospheric pressure were measured over a temperature range of 293 to 373 K, and average relative deviation (ARD) of correlation with Vogel--Fulcher--Tammann equation for viscosity were within 0.08\%. Correlation of the density data with the Tait equation could be obtained to within 0.02\% ARD. Isobaric expansivities calculated from the Tait equation were constant or decreased slightly with increasing temperature in accordance with trends commonly reported for ionic liquids. Parameters for the {$\varepsilon$}*-modified Sanchez--Lacombe equation of state are tabulated that allow correlation of the ionic-liquid high-pressure densities to within an ARD of less than 0.08\%.}
}

@article{holmesIsopiesticStudyAqueous1998,
  title = {An Isopiestic Study of Aqueous Solutions of the Alkali Metal Bromides at Elevated Temperatures},
  author = {Holmes, H. F. and Mesmer, R. E.},
  year = 1998,
  month = jun,
  journal = {The Journal of Chemical Thermodynamics},
  volume = {30},
  number = {6},
  pages = {723--741},
  issn = {0021-9614},
  doi = {10.1006/jcht.1997.0377},
  urldate = {2026-07-21},
  abstract = {Isopiestic molalities of aqueous solutions of the alkali metal bromides have been measured atT=383.15 K toT=498.15 K. Aqueous NaCl served as the isopiestic standard for the calculation of osmotic coefficients. The ion-interaction model gave an excellent fit to the experimental osmotic coefficients and provided parameters for the calculation of activity coefficients. Osmotic and activity coefficients both decrease with increasing temperature in this temperature range. A simple model is presented from which activity and osmotic coefficients (atpsat) can be calculated as a function of molality forT=273.15 K toT=523.15 K. Comparison of the stoichiometric activity coefficients with those of the corresponding alkali metal chlorides reveals quite complicated relative behavior.},
  keywords = {activity,high-temperature,isopiestic,MBr(aq),osmotic}
}

@article{hongModelingCO2Absorption2027,
  title = {Modeling of {{CO2}} Absorption in Aqueous Monoethanolamine with Weighted Carbamate and Bicarbonate Pathways},
  author = {Hong, Q. and Chen, X. H. and Pang, L. and Huang, Y. and Fang, M. X. and Jiang, L.},
  year = 2027,
  month = jan,
  journal = {Separation and Purification Technology},
  volume = {422},
  pages = {140522},
  issn = {1383-5866},
  doi = {10.1016/j.seppur.2026.140522},
  urldate = {2026-11-06},
  abstract = {For the monoethanolamine (MEA)-H2O-CO2 system, statistical associating fluid theory (SAFT) can implicitly represent chemical reactions through specific cross-association interactions, avoiding explicit ionic species and chemical equilibrium relations. However, CO2 absorption in aqueous MEA involves carbamate and bicarbonate pathways with CO2: MEA stoichiometric ratios of 1:2 and 1:1, respectively, and their relative contributions vary with loading and temperature. The existing models use two non-equivalent CO2 reactive sites to improve fitting, but these sites lack clear correspondence with the actual reaction pathways. Here, we develop a pathway-weighted association approach based on the perturbed-chain statistical associating fluid theory (PC-SAFT). Symmetric two-site and single-site association schemes represent the carbamate and bicarbonate pathways while a loading- and temperature-dependent pathway weight regulates their relative contributions. For 30\,wt\% aqueous MEA at CO2 loadings of 0.1--1.0\,mol CO2/mol MEA and temperatures of 313.15--393.15\,K, the average absolute relative deviation (AARD) for equilibrium CO2 partial pressure is 1.53\%, compared with 15.59\% for the asymmetric two-site model. Over 0.1--0.7\,mol CO2/mol MEA, the carbamate fraction agrees with reference species distributions from an electrolyte non-random two-liquid (eNRTL) model with an AARD of 5.51\%. For CO2 absorption enthalpy, the AARD decreases from 14.29\% to 9.48\%. The proposed approach may provide a basis for extension to other alkanolamine and polyamine systems involving multiple CO2 absorption pathways.},
  keywords = {CO absorption,Monoethanolamine,Pathway-weighted association,PC-SAFT}
}

