  author = {Quillinan, Scott and Nye, Charles and Engle, Mark and Bartos, Timothy T. and Neupane, Ghanashyam and Brant, Jonathan and Bagdonas, Davin and McLing, Travis and McLaughlin, J. Fred and Phillips, Erin and Hallberg, Laura L. and Shahabadi, Mahdi and Johnson, Matthew},
