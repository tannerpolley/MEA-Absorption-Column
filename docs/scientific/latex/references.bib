@article{sekineAssociationVDiketonesTrioctylphosphine1983,
  title = {Association of {$\beta$}-{{Diketones}} with {{Trioctylphosphine Oxide}} in {{Solvent Extraction Systems}}},
  author = {Sekine, Tatsuya and Saitou, Takashi and Iga, Hiroto},
  year = 1983,
  month = mar,
  journal = {Bulletin of the Chemical Society of Japan},
  volume = {56},
  number = {3},
  pages = {700--704},
  issn = {0009-2673},
  doi = {10.1246/bcsj.56.700},
  urldate = {2026-10-23},
  abstract = {Distribution of six {$\beta$}-diketones between hexane, benzene, carbon tetrachloride, or chloroform and 0.1 mol dm-3 aqueous perchlorate solutions has been measured in the presence of trioctylphosphine oxide (TOPO). The distribution ratio was, in many cases, enhanced by TOPO; this was explained in terms of association of the {$\beta$}-diketones and TOPO. The association constants were greater when the {$\beta$}-diketone was stronger as an acid and also in the following order of the diluent: CHCl3\&lt;CCl4\&lt;C6H6\&lt;C6H14. It was concluded that, even though the effect was not very large, still correction for the decrease in the concentrations of both the {$\beta$}-diketone and TOPO is necessary for an accurate estimation of the equilibrium involved in solvent extraction of metal ions containing these two reagents, as in the synergistic solvent extraction of metal ions.},
  keywords = {-Diketone extraction,/unread,Extractant association}
}

@article{sekineTransientMaximumSolvent1984,
  title = {Transient Maximum of Solvent Extraction of Copper({{II}}) with Some .{{BETA}}.-Diketones in Carbon Tetrachloride.},
  author = {Sekine, Tatsuya and Itoh, Nobuyuki},
  year = 1984,
  journal = {BUNSEKI KAGAKU},
  volume = {33},
  number = {10},
  pages = {E427-E434},
  publisher = {Japan Society for Analytical Chemistry},
