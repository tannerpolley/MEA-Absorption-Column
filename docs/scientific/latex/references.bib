  doi = {10.1021/je2010038},
  urldate = {2026-10-01},
  abstract = {Densities in liquid solutions of monoethanolamine (MEA) and water have been measured at temperatures from (298.15 to 423.15) K. The mass fraction of MEA ranged from 0.3 to 1.0. Excess volumes were correlated by a Redlich--Kister equation. The model uses a third-order Redlich--Kister equation and a linear relationship with the temperature. Densities of CO2 loaded aqueous MEA solutions were measured at temperatures from (298.15 to 413.15) K. The mass fraction of MEA was 0.3, 0.4, 0.5, and 0.6. Molar volumes of CO2 loaded aqueous MEA solutions were correlated by the equations from the literature. Polynomial equations are in turn used to correlate the parameters with the temperature. Surface tensions of aqueous MEA solutions were measured at temperatures from (303.15 to 333.15) K. The mass fraction of MEA ranged from 0 to 1.0. The experimental surface tension data were correlated with temperature and mole fraction, respectively.},
  langid = {english},
  keywords = {/unread,MetadataHunter: No Richer Record}
}

@article{hanHighlySelectiveRecovery2026,
  title = {Highly Selective Recovery of Lithium Ions from Concentrated Seawater Using a Stepwise Precipitation, Solvent Extraction and Stripping Process},
  author = {Han, Shanxu and Wang, Yangyang and Jing, Yi and Li, Rujie and Liu, Yajuan and Gao, Xinyu and Ren, Zhongqi and Zhou, Zhiyong},
  year = 2026,
  month = oct,
  journal = {Hydrometallurgy},
  volume = {244},
  pages = {106833},
  issn = {0304-386X},
  doi = {10.1016/j.hydromet.2026.106833},
  urldate = {2026-08-18},
  abstract = {A cascade solvent extraction process was proposed for recovering Li+ from concentrated seawater. First, solid (NH4)2CO3 and NaOH were used to successfully remove Ca2+ and Mg2+ as carbonate/hydroxide. Subsequently, by using 4,4,4-trifluoro-1-phenylbutane-1,3-dione (HBTA) and 2-octanone as the extractant and diluent, a single extraction-evaporation process was conducted to preliminarily enrich Li+ in the brine, reducing the Na/Li mass ratio from 47,500 to 142. Secondary extraction of the preliminarily enriched Li+ solution was conducted using the same extraction system. After extraction, the loaded organic phase was washed with a mixed solution of NH4Cl and LiCl, achieving a Na+ washing efficiency of 99.5\% without Li+ loss. Finally, the stripping process with HCl solution under high phase ratio achieved a 98\% recovery efficiency, yielding a lithium-rich solution with a lithium concentration of 3.14~\texttimes ~103~mg/L and a Na/Li mass ratio of 0.01. Mechanism studies confirmed that for {$\beta$}-diketone extractants like HBTA, the binding affinity for metal ions in alkaline brine followed the sequence Li+~{$>~$}Na+~{$>~$}K+. This process not only significantly reduced the Na/Li mass ratio in concentrated seawater from 47,500 to 0.01, but also achieved nearly 1500-fold cumulative concentration of Li+, providing a novel technical pathway for lithium extraction from concentrated seawater.},
  langid = {english},
  keywords = {Cascade solvent extraction,Concentrated seawater,Extraction mechanism,Extraction-evaporation process,Na/Li mass ratio}
}

@article{harknessIodideBromideAmmonium2015,
  title = {Iodide, {{Bromide}}, and {{Ammonium}} in {{Hydraulic Fracturing}} and {{Oil}} and {{Gas Wastewaters}}: {{Environmental Implications}}},
  shorttitle = {Iodide, {{Bromide}}, and {{Ammonium}} in {{Hydraulic Fracturing}} and {{Oil}} and {{Gas Wastewaters}}},
  author = {Harkness, Jennifer S. and Dwyer, Gary S. and Warner, Nathaniel R. and Parker, Kimberly M. and Mitch, William A. and Vengosh, Avner},
  year = 2015,
  month = feb,
  journal = {Environmental Science \& Technology},
  volume = {49},
  number = {3},
  pages = {1955--1963},
  issn = {0013-936X},
  doi = {10.1021/es504654n},
  urldate = {2026-11-19},
  abstract = {The expansion of unconventional shale gas and hydraulic fracturing has increased the volume of the oil and gas wastewater (OGW) generated in the U.S. Here we demonstrate that OGW from Marcellus and Fayetteville hydraulic fracturing flowback fluids and Appalachian conventional produced waters is characterized by high chloride, bromide, iodide (up to 56 mg/L), and ammonium (up to 420 mg/L). Br/Cl ratios were consistent for all Appalachian brines, which reflect an origin from a common parent brine, while the I/Cl and NH4/Cl ratios varied among brines from different geological formations, reflecting geogenic processes. There were no differences in halides and ammonium concentrations between OGW originating from hydraulic fracturing and conventional oil and gas operations. Analysis of discharged effluents from three brine treatment sites in Pennsylvania and a spill site in West Virginia show elevated levels of halides (iodide up to 28 mg/L) and ammonium (12 to 106 mg/L) that mimic the composition of OGW and mix conservatively in downstream surface waters. Bromide, iodide, and ammonium in surface waters can impact stream ecosystems and promote the formation of toxic brominated-, iodinated-, and nitrogen disinfection byproducts during chlorination at downstream drinking water treatment plants. Our findings indicate that discharge and accidental spills of OGW to waterways pose risks to both human health and the environment.}
}

