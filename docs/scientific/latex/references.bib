  year = 2020,
  pages = {269--284},
  publisher = {Springer International Publishing},
  address = {Cham},
  doi = {10.1007/978-3-030-36830-2_26},
  abstract = {As emerging technologies drive up demand for rare earths, value recoveryRare earth and critical materials recovery from recyclingRecycling end-of-life products provides an option for partially closing the material loop, conserving natural capital and enhancing resource security. Yet the techno-economic feasibility of recyclingRecycling depends on uncertainties associated with the feed input to the recovery process, and the effect of these uncertainties on the viability of the recyclingRecycling facility. In this study, we couple a first-principle solvent extractionSolvent extraction model with an economic model for a separation facility and apply it to assess byproduct recovery and rare earthRare earth and critical materials recovery separationSeparation from spent nickel-metal hydride batteriesBatteries, illustrating the significance of parametric uncertainties. The study shows the importance of risk-informed decision making in the investment, design, and operation of recyclingRecycling facilities.},
  isbn = {978-3-030-36830-2},
