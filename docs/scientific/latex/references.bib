@misc{cardosodemelloMicrowaveHeatingDielectric2024,
  type = {{{SSRN Scholarly Paper}}},
  title = {Microwave {{Heating}}, {{Dielectric Constant Determined}} by {{Reflectance Technique}} to {{Monoethanolamine}} and {{Amphoteric Salt Solutions}}},
  author = {{Cardoso de Mello}, Lilian and Pouzada, Eduardo and Borges, Renata and Castro, Renato},
  year = 2024,
  month = may,
  number = {4815430},
  eprint = {4815430},
  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4815430},
  urldate = {2026-11-28},
  abstract = {The global community is demanding a reduction in greenhouse gas emissions, forcing industries to look for efficient, low-cost, and clean technology to integrate into their manufacturing processes. Considering the amine regeneration step of the post-combustion carbon capture process based on a viable alternative and clean energy source of green chemistry and keeping in mind the industrial vision that always seeks operating cost reduction, this work investigated the primary amine behaviour, monoethanolamine (MEA), and the product formed from the reaction of this amine with carbon dioxide (CO2), the carbamate, when exposed to a high-frequency alternating current energy between 300 MHz and 300 GHz. The dissipation factor of each solution was measured in the time domain using the reflectance technique, demonstrating the high interaction between the electric field and the commercial solutions used in the CO2 capture process. This demonstrates that the use of microwaves as a heating source is very promising as an environmentally friendly alternative to be considered in the recovery process of solvents used in the desorption process.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {amphoteric salt,CO2,dielectric constant,microwave,monoethanolamine solution,reflection method}
}

