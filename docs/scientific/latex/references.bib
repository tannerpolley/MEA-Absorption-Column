@article{mehdizadehAMPCO2Water2013,
  title = {{{AMP}}--{{CO2}}--Water Thermodynamics, a Combination of {{UNIQUAC}} Model, Computational Chemistry and Experimental Data},
  author = {Mehdizadeh, Hamid and Gupta, Mayuri and Kim, Inna and Da Silva, Eirik F. and {Haug-Warberg}, Tore and Svendsen, Hallvard F.},
  year = 2013,
  month = oct,
  journal = {International Journal of Greenhouse Gas Control},
  volume = {18},
  pages = {173--182},
  issn = {1750-5836},
  doi = {10.1016/j.ijggc.2013.06.002},
  urldate = {2026-11-02},
  abstract = {AMP has for many years been considered a good absorbent for CO2 and in particular in mixtures with promoters as e.g. piperazine. AMP, as a primary amine, can form carbamate but steric hindrance prevents extensive formation. Its effect on equilibrium is not widely investigated and only one set of measurements for a single temperature is available. In this work the AMP carbamate formation constant is calculated using computational chemistry and a model based on the extended UNIQUAC framework is used to model partial pressures, speciation and heat of absorption. Also a set of measured differential heats of reaction are presented.},
  keywords = {2-Amino-2-methyl-1-propanol (AMP),Calorimetry,Carbamate formation,Computational chemistry,e-UNIQUAC,Heat of reaction}
}

@article{melnikovEffectCO2Loading2019,
  title = {The Effect of {{CO2}} Loading on Alkanolamine Absorbents in Aqueous Solutions},
  author = {Melnikov, Sergey M. and Stein, Matthias},
  year = 2019,
  month = sep,
  journal = {Physical Chemistry Chemical Physics},
  volume = {21},
  number = {33},
  pages = {18386--18392},
  issn = {1463-9076},
  doi = {10.1039/c9cp03976g},
  urldate = {2026-09-02},
  abstract = {Post-combustion carbon capture by amine scrubbing is the most frequently used process to remove CO2 from pulverized coal-fired power plants and also biogas flue gas streams. The quest for novel absorbents for CO2 capture with improved properties requires insight into the properties of the CO2-loaded mixed solutions. A comparative molecular dynamics study of the product state solutions, with chemically-bound CO2 of standard monoethanolamine (MEA) and the new alternative 4-diethylamino-2-butanol (DEAB) at various CO2-loadings yields solvent properties in good agreement with experimental data. The concentration of all post-reaction species in solution was based on experimental equilibria distributions. The data generated provide detailed insight into the properties of reactive mixed alkanolamine solutions. The liquid structure of aqueous MEA solutions undergoes only minor changes when absorbing CO2. The diffusion coefficients of all molecular species, however, decrease significantly with increasing CO2-loadings. The large hydrophobic clusters formed in the reactant state by DEAB molecules in water prior to CO2 binding significantly decrease in size and structure upon CO2 absorption. The diffusion coefficients of all components decrease with increasing CO2-loading, whereas the pre-reaction alkanolamine DEAB shows an increase in diffusion coefficient. This structural and kinetic information supports the molecular design and further development of novel compounds and provides data for a global process simulation and optimization.},
  langid = {english}
}

@article{merkleyEnthalpiesAbsorptionCarbon1987,
  title = {Enthalpies of Absorption of Carbon Dioxide in Aqueous Methyldiethanolamine Solutions},
  author = {Merkley, K. E. and Christensen, J. J. and Izatt, R. M.},
  year = 1987,
  month = nov,
  journal = {Thermochimica Acta},
  volume = {121},
  pages = {437--446},
  issn = {0040-6031},
  doi = {10.1016/0040-6031(87)80191-0},
  urldate = {2026-08-24},
  abstract = {An isothermal flow calorimeter was used to measure the enthalpies of absorption of carbon dioxide in aqueous 20, 40, and 60 wt.\% methyldiethanolamine (MDEA) solutions. The experimental temperature and pressure ranges were 288.71 to 422.04 K and 156 to 1466 kPa, respectively. The experimental equipment and procedure are described, with emphasis on the complexities originating from the difficulty of measuring the enthalpy of absorption of a gas in an aqueous solution. The calorimetric data were also found to be useful in determining the equilibrium concentrations of CO2in the MDEA solutions. Both enthalpy of absorption and equilibrium concentration data for CO2-aqueous MDEA systems are reported and compared with existing values from other investigations. The enthalpy of absorption of CO2 in aqueous MDEA solutions was found to be independent of pressure and linearly dependent upon both the temperature and the MDEA concentration. An equation is given for predicting the enthalpy of absorption over the ranges of temperatures, pressures, and concentrations investigated.}
}

@article{Meshram2025,
  title = {A Review on Assessment of Ionic Liquids in Extraction of Lithium, Nickel, and Cobalt Vis-\`a-Vis Conventional Methods},
  author = {Meshram, Pratima and Agarwal, Nikita and {Abhilash}},
  year = 2025,
  journal = {RSC Advances},
  volume = {15},
  number = {11},
  pages = {8321--8334},
  publisher = {Royal Society of Chemistry},
  issn = {20462069},
  doi = {10.1039/d4ra08429b},
  abstract = {This review discusses the extraction of critical metals (Li, Co, and Ni) using ionic liquids. Here, ionic liquids act as solvents for the separation and extraction of metals. In addition to extraction, they can be used as a lixiviant to leach out metals from spent lithium-ion batteries. Leaching and extraction of metals from the leachate can be performed using a single ionic liquid solvent. Lithium, cobalt, and nickel have been discussed in detail as per their reactivity towards an ionic liquid based on the extraction efficiency and reusability of the ionic liquid. Recycling and reusability of ionic liquids are crucial parameters to be considered while using them as solvents for extracting metals. Moreover, all the other methods such as solvent extraction, ion exchange, ionic liquids, and DES-based separation of metals are compared with respect to their extraction efficiency, cost-effectiveness, and reusability.}
}

@article{messikomerEnthalpyDilutionAqueous1975,
  title = {The Enthalpy of Dilution of Aqueous Sodium Chloride at 298.15 to 373.15 {{K}}, Measured with a Flow Calorimeter},
  author = {Messikomer, E. E and Wood, R. H},
  year = 1975,
  month = feb,
  journal = {The Journal of Chemical Thermodynamics},
  volume = {7},
  number = {2},
  pages = {119--130},
  issn = {0021-9614},
  doi = {10.1016/0021-9614(75)90259-1},
  urldate = {2026-11-04},
  abstract = {A new flow calorimeter has been used to measure the enthalpy of dilution of sodium chloride at 298 to 373 K and molalities from 0.04 to 5 mol kg-1. The results show that the flow calorimeter is ideally suited for obtaining high-temperature thermodynamic results. There is excellent agreement with the results of Ensor and Anderson from 313 to 353 K for molalities up to 1 mol kg-1. Above 1 mol kg-1 the present results are slightly higher (10 to 30 calth mol-1). The results have been used to calculate chnges in osmotic coefficient at 298 to 373 K as a function of molality. The osmotic coefficients are accurate to 0.001 and agree with the results of Ensor and Anderson. These results allow the comparison of the room-temperature osmotic coefficients with measurements at higher temperatures. The agreement of the high-temperature results with the low-temperature results is excellent. Excess heat capacities calculated from the results are in good agreement with previous measurements at room temperature and are reasonably consistent with high-temperature data.}
}

@article{messnaouiUseHygrometricMethod2020,
  title = {Use of the Hygrometric Method for Determination of Water Activity of an Aqueous Hydrochloric Acid System at 298.15 {{K}}},
  author = {Messnaoui, Brahim and Mounir, Abdelfetah and Dinane, Abderrahim},
  year = 2020,
  month = jul,
  journal = {Journal of Chemical \& Engineering Data},
  volume = {65},
  number = {7},
  pages = {3536--3545},
  issn = {0021-9568},
  doi = {10.1021/acs.jced.0c00107},
  urldate = {2026-10-22},
  abstract = {This paper aims to extend the application field of the hygrometric method to systems containing volatile electrolytes. In this way, the aqueous hydrochloric acid--water solution and the aqueous hydrochloric acid--potassium chloride--water system have been studied with the hygrometric method at the temperature 298.15 K. To take into account the hydrochloric acid volatility, we use a corrected ratio of droplet growth KAdjusted = 0.0105 + 0.998{$\cdot$}KExp (KExp is the measured ratio of droplet growth) obtained from experimental data of the hydrochloric acid--water system. The water activities and the corresponding osmotic coefficients are deduced from measurements of relative humidities of the HCl--KCl--H2O system against total molality ranging from 0.3 to 7.5 mol{$\cdot$}kg--1 and for different ionic-strength fractions y of HCl y = IHCl/(IKCl + IHCl)) of 1/3, 1/2, 2/3, 3/4, 10/11, and 15/16 at 298.15 K. The results obtained were correlated using the PSC model to predict the solute activity coefficients in a mixture for different compositions of the aqueous solution of the hydrochloric acid system. The obtained results are used to determine the solubility and excess Gibbs energy in the studied molality range.},
  langid = {english},
  keywords = {/unread}
}

