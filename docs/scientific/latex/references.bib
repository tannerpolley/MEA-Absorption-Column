  title = {Water Activities, Osmotic and Activity Coefficients in Aqueous Chloride Solutions {{atT}}~=~ 298.15 {{K}} by the Hygrometric Method},
  author = {Guendouzi, Mohamed El and Dinane, Abderrahim and Mounir, Abdelfetah},
