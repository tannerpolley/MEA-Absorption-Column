@article{silkenbaumerSolubilityCarbonDioxide1998,
  title = {Solubility of {{Carbon Dioxide}} in {{Aqueous Solutions}} of 2-{{Amino-2}}-Methyl-1-Propanol and {{N-Methyldiethanolamine}} and {{Their Mixtures}} in the {{Temperature Range}} from 313 to 353 {{K}} and {{Pressures}} up to 2.7 {{MPa}}},
