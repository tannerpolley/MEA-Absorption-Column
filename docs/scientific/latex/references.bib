  pages = {631--636},
  issn = {0021-9568},
  doi = {10.1021/je980217x},
  urldate = {2026-11-09},
  abstract = {Measurements of the heat capacities of the alkanolamines monoethanolamine, diethanolamine, diglycolamine, di-2-propanolamine, triethanolamine, N-methyldiethanolamine, 2-amino-2-methyl-l-propanol, and 2-piperidineethanol were performed from 30 to 80 {$^\circ$}C with a differential scanning calorimeter (DSC). The heat capacity of liquid water has been measured to verify the validity of the Cp measurements. The measured Cp of each alkanolamine has been expressed as a function of temperature. The estimated uncertainty of the measured heat capacities including the effect of impurities in a substance with a purity of 95\% is \textpm 3\%. The measured heat capacities are, in general, of sufficient accuracy for most engineering-design calculations.}
}

