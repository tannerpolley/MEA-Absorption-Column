  keywords = {/unread,2-Dimethylaminoethanol (DMAE),Diethanolamine (DEA),Heat capacities,MetadataHunter: No Richer Record,Monoethanolamine (MEA),N-methyldiethanolamine (MDEA),Piperazine (PZ),Triethanolamine (TEA)}
