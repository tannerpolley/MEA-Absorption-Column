@article{parkCorrelationPredictionSolubility2002a,
  title = {Correlation and Prediction of the Solubility of Carbon Dioxide in Aqueous Alkanolamine and Mixed Alkanolamine Solutions},
  author = {Park, Sang Hyun and Lee, Ki Bong and Hyun, Jae Chun and Kim, Sung Hyun},
