  shorttitle = {The},
  author = {Lee, Andrew and Ghouse, Jaffer H. and Eslick, John C. and Laird, Carl D. and Siirola, John D. and Zamarripa, Miguel A. and Gunter, Dan and Shinn, John H. and Dowling, Alexander W. and Bhattacharyya, Debangsu and Biegler, Lorenz T. and Burgard, Anthony P. and Miller, David C.},
