@article{clarkeEvaluationThermodynamicFunctions1985,
  title = {Evaluation of the {{Thermodynamic Functions}} for {{Aqueous Sodium Chloride}} from {{Equilibrium}} and {{Calorimetric Measurements}} below 154\,{$^\circ$}{{C}}},
  author = {Clarke, E. Colin W. and Glew, David N.},
  year = 1985,
