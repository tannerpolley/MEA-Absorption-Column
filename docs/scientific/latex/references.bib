@article{sahlodinNonsmoothModelDynamic2016a,
  title = {Nonsmooth Model for Dynamic Simulation of Phase Changes},
  author = {Sahlodin, Ali M. and Watson, Harry A. J. and Barton, Paul I.},
  year = 2016,
  journal = {AIChE Journal},
  volume = {62},
  number = {9},
  pages = {3334--3351},
  publisher = {Wiley},
  issn = {1547-5905},
  doi = {10.1002/aic.15378},
  urldate = {2026-11-24},
  abstract = {Dynamic modeling of processes involving phase changes can be challenging due to changes in the model equations caused by appearance and disappearance of equilibrium phases. Dynamic simulation of these processes requires the ability to detect the change in the number of phases and adapt the model to the new phase regime on the fly. In this work, an easy-to-use nonsmooth model for dynamic simulation of processes with vapor-liquid equilibrium is presented. The presented model does not introduce any auxiliary variables or equations, nor does it require solution of an optimization problem to determine the new phase regime during the dynamic simulation. It can therefore be used for comprehensive simulation of, e.g., distillation columns, where the number of phases present can change during startup and shutdown. The nonsmooth model is illustrated through examples of an evaporator and a distillation column. \copyright{} 2016 American Institute of Chemical Engineers AIChE J, 62: 3334--3351, 2016},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
  keywords = {distillation column,dynamic simulation,flash calculation,shutdown,startup}
}

@article{Saimpert2013,
  title = {A New Rate Based Absorber and Desorber Modelling Tool},
  author = {Saimpert, Matthias and Puxty, Graeme and Qureshi, Saad and Wardhaugh, Leigh and Cousins, Ashleigh},
  year = 2013,
  journal = {Chemical Engineering Science},
  volume = {96},
  pages = {10--25},
  publisher = {Elsevier},
  issn = {00092509},
  doi = {10.1016/j.ces.2013.03.013},
  abstract = {Modelling of the absorber and desorber of a CO2 capture process is a challenging and complex task involving a range of physical and chemical phenomena. In this work rate based absorber and desorber models have been developed in the MATLAB\textregistered{} programming environment. The models have been created from first principles allowing complete control over the chemical and physical parameters used and are completely based on literature data, with no parameter regression. The transparency of the models allowed detailed investigation of all aspects of the model performance, in particular idiosyncrasies of the desorption process. The model has been validated against absorption and desorption data from CSIRO's PCC Process Development Facility and a pilot plant located at Tarong Power Station in Queensland, Australia. Both processes were operating with aqueous MEA. In terms of absorption the model accurately predicted the location and extent of CO2 absorption in the column. In terms of desorption the model predicted both where desorption was occurring (solvent inlet, column, reboiler) and the total amount of CO2 desorbed. The flexibility of this model will prove invaluable for the assessment of new solvents and process modifications. \copyright{} 2013.},
  keywords = {Absorption,Desorption,Mass transfer,Mathematical modelling,Packed bed}
}

