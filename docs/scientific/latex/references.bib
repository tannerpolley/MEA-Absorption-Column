@article{samantaDensityViscosityAqueous2006,
  title = {Density and {{Viscosity}} of {{Aqueous Solutions}} of {{Piperazine}} and (2-{{Amino-2}}-Methyl-1-Propanol + {{Piperazine}}) from 298 to 333 {{K}}},
  author = {Samanta, Arunkumar and Bandyopadhyay, Syamalendu S.},
