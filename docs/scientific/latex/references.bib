  title = {Density, Viscosity and Thermodynamic Activation for Viscous Flow of Water+sulfolane},
  author = {Saleh, Muhammad A. and Shamsuddin Ahmed, M. and Begum, Syeda K.},
  year = 2006,
  month = apr,
  journal = {Physics and Chemistry of Liquids},
  volume = {44},
  number = {2},
  pages = {153--165},
  publisher = {Taylor \& Francis},
  issn = {0031-9104},
  doi = {10.1080/00319100500217819},
  urldate = {2026-08-25},
  abstract = {Densities and viscosities for the system, water (W) + sulfolane (SFL), have been determined for the entire range of composition at temperatures ranging from 303.15 to 323.15 K. Density, excess molar volume, viscosity, excess viscosity and thermodynamic activation parameters for viscous flow have been calculated and plotted against the mole fraction of SFL. The measured properties and some of the derived properties have been fitted to appropriate polynomial equations. These have been explained in terms of such factors, as, dipole--dipole interaction, partial accommodation of water molecules into the structural network of SFL and H-bonding between SFL and H2O.},
  keywords = {Density,Excess molar volume,Sulfolane,Thermodynamic activation parameters for viscous flow,Viscosity}
}

@article{salujaApparentMolarHeat1986,
  title = {Apparent Molar Heat Capacities and Volumes of Aqueous Solutions of Several 1:1 Electrolytes at Elevated Temperatures},
  shorttitle = {Apparent Molar Heat Capacities and Volumes of Aqueous Solutions of Several 1},
  author = {Saluja, Preet P. S. and LeBlanc, Jacques C. and Hume, Harold B.},
  year = 1986,
  month = may,
  journal = {Canadian Journal of Chemistry},
  volume = {64},
  number = {5},
  pages = {926--931},
  publisher = {NRC Research Press},
  issn = {0008-4042},
  doi = {10.1139/v86-153},
  urldate = {2026-10-29},
  abstract = {The results of heat capacity (Cp) and density (d) measurements at 0.6 MPa and in the temperature range 298.15--373.15\enspace K are presented for several 1:1 electrolytes in water. The flow microcalorimeter and densimeter used for these measurements were modificatons of the room-temperature designs. Data were obtained over concentrations ranging from 0.02 to 1.0\enspace mol kg-1 (or to the solubility limit, whichever was lower). The heat capacity of a solution relative to that of water was measured with a precision of \textpm 0.1\enspace mJ K-1 g-1 at all temperatures. The density of a solution relative to that of water was measured with a precision of \textpm 5\enspace{$\mu$}g cm-3. These Cp and d results were used to calculate the apparent molar heat capacities, , and volumes, , at 298.15, 323.15, 348.15, and 373.15\enspace K, at a constant pressure of 0.6 MPa. These results are in good agreement with available literature data.}
}

