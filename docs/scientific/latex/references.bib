}

@article{edlerMeltingPointPalladium2016,
  title = {The {{Melting Point}} of {{Palladium Using Miniature Fixed Points}} of {{Different Ceramic Materials}}: {{Part I}}---{{Principles}} and {{Performances}}},
  shorttitle = {The {{Melting Point}} of {{Palladium Using Miniature Fixed Points}} of {{Different Ceramic Materials}}},
  author = {Edler, F. and Huang, K.},
  year = 2016,
  month = oct,
  journal = {International Journal of Thermophysics},
  volume = {37},
  number = {12},
  pages = {126},
  issn = {1572-9567},
  doi = {10.1007/s10765-016-2134-1},
  urldate = {2026-10-12},
  abstract = {Fifteen miniature fixed-point cells made of three different ceramic crucible materials (\$\$\textbackslash hbox \textbraceleft Al\textbraceright\_\textbraceleft 2\textbraceright\textbackslash hbox \textbraceleft O\textbraceright\_\textbraceleft 3\textbraceright,\textbackslash, \textbackslash hbox \textbraceleft ZrO\textbraceright\_\textbraceleft 2\textbraceright\$\$, and \$\$\textbackslash hbox \textbraceleft Al\textbraceright\_\textbraceleft 2\textbraceright\textbackslash hbox \textbraceleft O\textbraceright\_\textbraceleft 3\textbraceright{} (86\textbackslash,\textbackslash\%)+\textbackslash hbox \textbraceleft ZrO\textbraceright\_\textbraceleft 2\textbraceright\$\$(14~\%)) were filled with pure palladium and used for the calibration of type B thermocouples (Pt30\%Rh/Pt6\%Rh). The melting behavior of the palladium was investigated by using different high-temperature furnaces usable in horizontal and vertical positions. It was found that the electromotive forces measured at the melting temperature of palladium are consistent with a temperature equivalent of \textpm 0.25 K when using a furnace with an adequate temperature homogeneity (\textpm 1 K over a length of 12 cm), independent of the ceramic crucible materials. The emfs measured in the one-zone furnaces with larger temperature gradients along the crucibles are sensitive related to the position of the crucibles in the temperature gradient of these furnaces. This is caused by higher parasitic heat flux effects which can cause measurement errors up to about \$\$\textbackslash text \textbraceleft -\textbraceright\$\$(1\$\$\textbackslash text \textbraceleft -\textbraceright\$\$2) K, depending on the thermal conductivity of the ceramic material. It was found that the emfs measured by using crucibles with lower thermal conductivity \$\$(\textbackslash hbox \textbraceleft ZrO\textbraceright\_\textbraceleft 2\textbraceright )\$\$were less dependent on parasitic heat flux effects than crucibles made of material of higher thermal conductivity \$\$(\textbackslash hbox \textbraceleft Al\textbraceright\_\textbraceleft 2\textbraceright\textbackslash hbox \textbraceleft O\textbraceright\_\textbraceleft 3\textbraceright )\$\$. The investigated miniature fixed points are suitable for the repeatable realization of the melting point of palladium to calibrate noble metal thermocouples without the disadvantages of the wire-bridge method or the wire-coil method.},
  langid = {english},
  keywords = {/unread,Calibration,Ceramic materials,Melting point of palladium,MetadataHunter: No Richer Record,Miniature fixed points,Thermocouples}
}

@article{edwardsVaporliquidEquilibriaMulticomponent1978,
  title = {Vapor-Liquid Equilibria in Multicomponent Aqueous Solutions of Volatile Weak Electrolytes},
  author = {Edwards, T. J. and Maurer, Gerd and Newman, John and Prausnitz, J. M.},
  year = 1978,
  journal = {AIChE Journal},
  volume = {24},
  number = {6},
  pages = {966--976},
  issn = {1547-5905},
  doi = {10.1002/aic.690240605},
  urldate = {2026-09-21},
  abstract = {A molecular-thermodynamic correlation is established for calculating vapor-liquid equilibria in aqueous solutions containing one or more volatile electrolytes: ammonia, carbon dioxide, hydrogen sulfide, sulfur dioxide, and hydrogen cyanide. The correlation is similar to that presented in 1975, but the domain of application has been increased. The present correlation holds from about 0{$^\circ$} to 170{$^\circ$}C and for ionic strengths of about 6 molal; for the weak electrolytes considered here, this corresponds to total concentrations between 10 and 20 molal. To represent activities at these high concentrations, activity coefficients are expressed as a function of molality by Pitzer's equation. Required parameters are estimated from data reduction or from correlations. Special attention is given to the ternary systems ammonia-carbon dioxide-water and ammonia-hydrogen sulfide-water. Calculated equilibria are in satisfactory agreement with the severely limited experimental data now available.},
  copyright = {Copyright \copyright{} 1978 American Institute of Chemical Engineers},
  langid = {english},
  keywords = {/unread}
}

