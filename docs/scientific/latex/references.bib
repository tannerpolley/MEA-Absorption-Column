@article{Atanassova2021,
  title = {Solvent Extraction Chemistry in Ionic Liquids: {{An}} Overview of f-Ions},
  author = {Atanassova, Maria},
  year = 2021,
  journal = {Journal of Molecular Liquids},
  volume = {343},
  pages = {117530},
  publisher = {Elsevier B.V.},
  issn = {01677322},
  doi = {10.1016/j.molliq.2021.117530},
  abstract = {Undoubtedly, ionic liquids (ILs) belong to the most investigated solvent systems in the last two decades not only in the field of liquid--liquid extraction and separation chemistry of metallic species. Nowadays, the academic research interest is still significantly growing with an increased focus on developing such ``smart'' reagents for very specific applications. Interesting from the research point of view are solvent extraction systems capable of discriminating between metal ions from within, or between 4f and 5f elements that will be reviewed and discussed herein including the design of new ionic liquid compounds. Most of the investigations have been done for the first time suggesting novel, unfamiliar cutting-edge research investigating ideas. This paper reviews previous literatures and our recent results adopting ILs in metal liquid--liquid extraction systems until the end of year 2020 with an emphasis on the synergistic effect, where possible, and task-specific ILs together with some accidentally established enhancements. Finally, a critical analysis on the lanthanoids intra-group selectivity versus the extraction performance in an ionic medium and, on the other hand, the nature of the water-immiscible ionic diluents used have also been carried out and is here presented, and critically addressed.},
  keywords = {f-block elements,Ionic liquids,Liquid-liquid extraction,Separation,Synergism}
}

@article{Austgen1991,
  title = {Model of {{Vapor-Liquid Equilibria}} for {{Aqueous Acid Gas-Alkanolamine Systems}}. 2. {{Representation}} of {{{\ce{H2S}}}} and {{{\ce{CO2}} Solubility}} in {{Aqueous MDEA}} and {{{\ce{CO2}} Solubility}} in {{Aqueous Mixtures}} of {{MDEA}} with {{MEA}} or {{DEA}}},
  author = {Austgen, David M and Rochelle, Gary T and Chen, Chau-Chyun},
  year = 1991,
  journal = {Industrial \& Engineering Chemistry Research},
  volume = {30},
  number = {3},
  pages = {543--555},
  issn = {0888-5885, 1520-5045},
  doi = {10.1021/ie00051a016},
  abstract = {A physicochemical model developed in earlier work for representing Ha and C02 solubility in aqueous solutions of monoethanolamine (MEA) and diethanolamine (DEA) was extended to include the mixtures of methyldiethanolamine (MDEA) with MEA or DEA. The framework of the model is based upon both liquid-phase chemical equilibria and vapor-liquid (phase) equilibria. Activity coefficients are represented with the electrolyte-NRTL equation treating both long-range electrostatic interactions and short-range binary interactions. Adjustable binary interaction parameters of the model were fitted on binary and ternary system MDEA data reported in the literature. The solubility of C02 in aqueous mixtures of MDEA with MEA or DEA was measured at 40 and 80 "C over a wide range of C02 partial pressures. Representation of the data by the model is good, especially at low to moderate acid gas loadings.},
  langid = {english}
}

