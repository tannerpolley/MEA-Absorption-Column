@article{ciftja13CNMRMethod2013,
  title = {{{13C NMR}} as a Method Species Determination in {{CO2}} Absorbent Systems},
  author = {Ciftja, Arlinda F. and Hartono, Ardi and Svendsen, Hallvard F.},
  year = 2013,
  month = aug,
  journal = {International Journal of Greenhouse Gas Control},
  volume = {16},
  pages = {224--232},
  issn = {1750-5836},
  doi = {10.1016/j.ijggc.2013.04.006},
  urldate = {2026-11-02},
  abstract = {This paper discusses the main parameters to be considered when using Nuclear Magnetic Resonance Spectroscopy for speciation in liquid phase CO2 capture absorbents and how accurate measurements can be obtained. Liquid phase speciation is one of the most important experimental data for thermodynamic and kinetic modeling of absorption systems. A comprehensive standard method for liquid phase speciation in amine and amino acid--CO2--H2O systems by Nuclear Magnetic Resonance Spectroscopy is presented and validated against measurements on monoamine, diamine and amino acid systems. The CO2 loadings calculated from NMR and titration methods are shown to be in good agreement with an AARD less than 1\%. The most important factor for a quantitative measurement with 13C NMR is delay time which is required to be {$\geq$}5 times the relaxation time (T1) and 300 numbers of scans. The relaxation times (T1) of carbon nucleus of several amines commonly used in CO2 capture, i.e. monoethanolamine (MEA), diethanolamine (DEA), ethylenediamine (EDA), 2-amino-2 methylpropan-1-ol (AMP), N-methyldiethanolamine (MDEA) and piperazine (PZ) as well as for loaded aqueous solutions of MEA--amino acids salt systems of Glycine, Taurine, l-Alanine, l-Serine, l-Proline and Sarcosine are determined and reported in the present work. The relaxation time for the carbon nuclei of HCO3-/CO32- in monoamine systems increases in this order: AMP (3.5s)=DEA (3.5s)},
  keywords = {Amine,Amino acid,C NMR parameters,CO capture,Relaxation time}
}

@article{ciftjaExperimentalStudyCarbamate2014a,
  title = {Experimental Study on Carbamate Formation in the {{AMP}}--{{CO2}}--{{H2O}} System at Different Temperatures},
  author = {Ciftja, Arlinda F. and Hartono, Ardi and Svendsen, Hallvard F.},
  year = 2014,
  month = apr,
  journal = {Chemical Engineering Science},
  volume = {107},
  pages = {317--327},
  publisher = {Elsevier BV},
  issn = {0009-2509},
  doi = {10.1016/j.ces.2013.12.028},
  urldate = {2026-11-02},
  abstract = {Carbamate formation in the 30wt\% of 2-amino-2-methyl-1-propanol (AMP) system at different CO2 loadings and temperatures was studied via nuclear magnetic resonance (NMR) spectroscopy. The results indicate that the main species in this system are AMP/AMPH+, AMPCO2- and HCO3-/CO32-. The carbamate was also observed at low loadings and the apparent carbamate stability constant was estimated based on the experimental concentrations of the species from NMR analysis. Carbamate formation was found to have weak temperature dependence in the range tested (25--45{$^\circ$}C). To distinguish within the AMP/AMPH+ and HCO3-/CO32- pairs, the amine protonation constant, the dissociation constant of carbonic acid from literature, and pH measurements for different ionic strengths were all employed. All the data were correlated with ionic strength and temperature. The accuracy of the carbamate stability constant determined from the concentration measurements will depend on pKa, ionic strength (I) used to calculate the speciation and on the uncertainty in the species concentration determinations from NMR, particularly for the carbamate species at low CO2 loadings and high temperature.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid = {english},
  keywords = {AMP,Carbamate stability,CO capture,NMR,Sterically hindered amine}
}

