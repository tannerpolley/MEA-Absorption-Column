@article{pattersonCarbonateEquilibriaHydrothermal1982,
  title = {Carbonate Equilibria in Hydrothermal Systems: First Ionization of Carbonic Acid in {{NaCl}} Media to 300{$^\circ$}{{C}}},
  shorttitle = {Carbonate Equilibria in Hydrothermal Systems},
  author = {Patterson, C. S and Slocum, G. H and Busey, R. H and Mesmer, R. E},
  year = 1982,
  month = sep,
