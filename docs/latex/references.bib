}

@article{wongSituMeasurementPhysical2016,
  title = {In Situ Measurement of Physical Solubility of Carbon Dioxide in Loaded Aqueous Monoethanolamine by {{Raman}} Spectroscopy},
  author = {Wong, M. K. and Bustam, M. A. and Shariff, A. M.},
  year = 2016,
  month = nov,
  journal = {Journal of Natural Gas Science and Engineering},
  volume = {36},
  pages = {305--313},
  issn = {1875-5100},
  doi = {10.1016/j.jngse.2016.10.029},
  urldate = {2026-08-24},
  abstract = {Physical solubility is a physicochemical parameter necessary for reaction kinetic study and modeling CO2 separation process. When CO2 absorb into liquid phase and react with solvent, shift in chemical composition and equilibrium results in change in properties of solvent. As CO2 absorption is a continuous process with CO2 dissolving into partially loaded solution most of the time, availability of a robust technique to access unreacted CO2 dissolved in aqueous phase is crucial to study effect of CO2 loading on physical solubility. Current work investigates physical solubility of CO2 in loaded monoethanolamine (MEA) solution at elevated pressure conditions by direct measurement of unreacted CO2 dissolved in the solution using Raman spectroscopy. This spectroscopic method does not require N2O as surrogate gas, hence eliminates the need of N2O analogy to estimate solubility of CO2. Impact of varying CO2 loadings on Henry's constant is examined.},
  keywords = {CO absorption,CO loading,Equilibrium,Henry's constant,MEA},
  file = {/home/tnnrpolley21/Zotero/storage/KRAEQGSG/Wong et al. - 2016 - In situ measurement of physical solubility of carbon dioxide in loaded aqueous monoethanolamine by R.pdf;/home/tnnrpolley21/Zotero/storage/S27SQ8VT/S1875510016307673.html}
}

@article{Wu2019,
  title = {Electrical {{Conductivity}} of {{Lithium Chloride}}, {{Lithium Bromide}}, and {{Lithium Iodide Electrolytes}} in {{Methanol}}, {{Water}}, and {{Their Binary Mixtures}}},
  author = {Wu, Xi and Gong, Ying and Xu, Shiming and Yan, Ziteng and Zhang, Xinjie and Yang, Shuaishuai},
  year = 2019,
  month = oct,
  journal = {Journal of Chemical and Engineering Data},
  volume = {64},
  number = {10},
  pages = {4319--4329},
  publisher = {American Chemical Society},
  issn = {15205134},
  doi = {10.1021/acs.jced.9b00405},
  abstract = {Low-grade thermal energy can be converted to electricity by integrating multi-effect distillation and reverse electrodialysis technologies. The energy conversion efficiency of such a system is strongly influenced by the working solution. Here, six binary solutions (LiCl/LiBr/LiI in H2O and LiCl/LiBr/LiI in methanol) and three ternary solutions (LiCl/LiBr/LiI in methanol and H2O mixture) are assessed as candidate working solutions. Electrical conductivities of these solutions were measured over a wide concentration range (up to 12.4 mol{$\cdot$}kg-1), and the results were examined with the Casteel-Amis equation and the modified Gaussian amplitude equation. Previous experimental results have shown that the electrical conductivity of solutions is influenced by the concentration, temperature, and characteristics of the solute and solvent. At 293.15 K, the maximum electrical conductivity was 201.6 \textpm{} 3.8 mS{$\cdot$}cm-1 for an aqueous LiI solution at 6.38 mol{$\cdot$}kg-1. Furthermore, the electrical conductivity decreased in the order: LiI-solvent {$>$} LiBr-solvent {$>$} LiCl-solvent (for the same solvent) and LiX (X = I, Br, or Cl)-H2O {$>$} LiX-methanol-H2O {$>$} LiX-methanol (for the same solute) under the same concentration and temperature conditions. Hence, LiX-methanol-H2O ternary solutions show good potential as working solutions considering their electrochemical and thermodynamic properties comprehensively.},
  file = {/home/tnnrpolley21/Zotero/storage/58W7VSUG/Wu et al. - 2019 - Electrical Conductivity of Lithium Chloride, Lithium Bromide, and Lithium Iodide Electrolytes in Met.pdf}
}

@article{wuThermodynamicModelingSolid2023,
  title = {Thermodynamic {{Modeling}} the {{Solid}}--{{Liquid Phase Equilibrium}} of a {{Water}}--{{Methanol}}--{{Potassium Dihydrogen Phosphate Ternary System}} with a {{Mixed-Solvent Electrolyte}} ({{MSE}}) {{Model}}},
