  file = {/home/tnnrpolley21/Zotero/storage/7Y4UDV2P/Camacho et al. - 2009 - Kinetics of the reaction of pure CO2 with N-methyldiethanolamine in aqueous solutions.pdf;/home/tnnrpolley21/Zotero/storage/GN6GRGTV/kin.html}
}

