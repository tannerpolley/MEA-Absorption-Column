@article{pontesMeasurementPCSAFTModeling2017,
  title = {Measurement and {{PC-SAFT}} Modeling of Solid-Liquid Equilibrium of Deep Eutectic Solvents of Quaternary Ammonium Chlorides and Carboxylic Acids},
  author = {Pontes, Paula V. A. and Crespo, Emanuel A. and Martins, M{\'o}nia A. R. and Silva, Liliana P. and Neves, Catarina M. S. S. and Maximo, Guilherme J. and Hubinger, Miriam Dupas and Batista, Eduardo A. C. and Pinho, Sim{\~a}o P. and Coutinho, Jo{\~a}o A. P. and Sadowski, Gabriele and Held, Christoph},
  year = 2017,
  month = sep,
  journal = {Fluid Phase Equilibria},
  series = {Deep {{Eutectic Solvents}}},
  volume = {448},
  pages = {69--80},
  issn = {0378-3812},
  doi = {10.1016/j.fluid.2017.04.007},
  urldate = {2026-07-28},
  abstract = {In this study the solid-liquid equilibria (SLE) of 15 binary mixtures composed of one of three different symmetrical quaternary ammonium chlorides and one of five different fatty acids were measured. The experimental data obtained showed extreme negative deviations to ideality causing large melting-temperature depressions (up to 300~K) that are characteristic for deep eutectic systems. The experimental data revealed that cross-interactions between quaternary ammonium salt and fatty acid increase with increasing alkyl chain length of the quaternary ammonium chloride and with increasing chain length of the carboxylic acid. The pronounced decrease of melting temperatures in these deep eutectic systems is mainly caused by strong hydrogen-bonding interactions, and thermodynamic modeling required an approach that takes hydrogen bonding into account. Thus, the measured phase diagrams were modeled with perturbed-chain statistical associating fluid theory based on the classical molecular homonuclear approach. The model showed very good agreement with the experimental data using a semi-predictive modeling approach, in which binary interaction parameters between quaternary ammonium chloride and carboxylic acid correlated with chain length of the components. This supports the experimental findings on the phase behavior and interactions present in these systems and it allows estimating eutectic points of such highly non-ideal mixtures.},
  keywords = {Fatty acids,Melting properties,Phase diagrams,Tetra alkyl ammonium salts,Thermodynamics},
  file = {/home/tnnrpolley21/Zotero/storage/GS83MU7G/Pontes et al. - 2017 - Measurement and PC-SAFT modeling of solid-liquid equilibrium of deep eutectic solvents of quaternary.pdf;/home/tnnrpolley21/Zotero/storage/9YZ5TE8M/S0378381217301474.html}
}

