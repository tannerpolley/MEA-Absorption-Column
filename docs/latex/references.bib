@article{Krishnan2024,
  title = {A Comprehensive Review of Lithium Extraction: {{From}} Historical Perspectives to Emerging Technologies, Storage, and Environmental Considerations},
  author = {Krishnan, Renjith and Gopan, Gokul},
  year = 2024,
  journal = {Cleaner Engineering and Technology},
  volume = {20},
  number = {November 2023},
  pages = {100749},
  publisher = {Elsevier Ltd},
  issn = {26667908},
  doi = {10.1016/j.clet.2024.100749},
  abstract = {Lithium, a vital element in lithium-ion batteries, is pivotal in the global shift towards cleaner energy and electric mobility. The relentless demand for lithium-ion batteries necessitates an in-depth exploration of lithium extraction methods. This literature review delves into the historical evolution, contemporary practices, and emerging technologies of lithium extraction. It scrutinizes environmental and economic impacts, identifies research gaps, and underscores sustainable extraction's imperative. It examines conventional methods like spodumene mining and brine extraction, highlighting their advantages and challenges. Emerging technologies, particularly Direct Lithium Extraction (DLE) and geothermal brine recovery, are evaluated for their potential to revolutionize the industry. Environmental considerations, including water usage, chemical disposal, and habitat disruption, are assessed alongside economic implications. The review also identifies critical research gaps, beckoning the scientific community to develop solutions that meet lithium's surging demand while safeguarding the environment. In conclusion, this literature review emphasizes the need for sustainable lithium extraction to facilitate a future powered by cleaner energy sources and sustainable transportation.},
  keywords = {Cleaner energy sources,Electric mobility,Lithium,Lithium extraction methods,Lithium-ion batteries},
  file = {/home/tnnrpolley21/Zotero/storage/5YWBG7V3/Krishnan and Gopan - 2024 - A comprehensive review of lithium extraction From historical perspectives to emerging technologies,.pdf}
}

