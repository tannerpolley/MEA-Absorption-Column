@article{Held2008,
  title = {Modeling Aqueous Electrolyte Solutions. {{Part}} 1. {{Fully}} Dissociated Electrolytes},
  author = {Held, Christoph and Cameretti, Luca F. and Sadowski, Gabriele},
  year = 2008,
  journal = {Fluid Phase Equilibria},
