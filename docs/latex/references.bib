  author = {Wang, Yangyang and Li, Rujie and Han, Shanxu and Jing, Yi and Gao, Xinyu and Liu, Yajuan and Ren, Zhongqi and Zhou, Zhiyong},
  year = 2026,
  month = feb,
  journal = {Chemical Engineering Science},
  volume = {321},
  pages = {122945},
  issn = {0009-2509},
  doi = {10.1016/j.ces.2025.122945},
  urldate = {2026-07-21},
  abstract = {A TIBP assisted HBTA synergistic extraction system was developed for selective lithium recovery from gasfield brine with ultra-low Li/Na mass ratio (33~ppm Li, Na/Li~=~578). The mechanistic investigations of neutral phosphate ester and {$\beta$}-diketone direct mixed system were performed. Experimental and computational analyses revealed that TIBP exhibited dual functionality including the P=O group and deprotonated HBTA coordinated with Li+ to form a energetically favorable [TIBP]Li[BTA] complexes, thus improving the lithium selectivity and intermolecular hydrogen bonding between TIBP and HBTA immobilized non-coordinated HBTA in the organic phase, mitigating extractant degradation. Quantum chemical calculations and visualization of molecular structures confirmed that TIBP promoted keto-enol tautomerization of HBTA toward favorable deprotonation while optimizing the electrostatic potential distribution. An efficient and selective lithium extraction process was established through parameter optimizations. A two-stage extraction efficiency of lithium ion exceeding 97~\% was achieved using 0.02~mol/L HBTA and 40~vol\% TIBP in kerosene at O/A = 1. Subsequent three-stage crossflow washing processes with 0.3~mol/L NH4Cl attained over 99~\% sodium removal with lithium loss below 1.6~ppm, followed by high O/A phase ratio stripping using 1~mol/L HCl to concentrate lithium ion beyond 1000~ppm. The system maintained consistent performance over ten extraction-washing-stripping cycles with no necessary of regeneration of the organic phase or replenishment additives, demonstrating exceptional stability attributed to the hydrogen bonding network. This work established a practical strategy for lithium enrichment from challenging brine sources while elucidating the fundamental synergistic mechanisms underlying neutral phosphate ester and {$\beta$}-diketone hybrid systems.},
  keywords = {DFT computation,Extraction mechanism,Gasfield water,Hydrogen bond,Solvent extraction},
  file = {/home/tnnrpolley21/Zotero/storage/APQPXMRT/Wang et al. - 2026 - Dual-functional extraction system for recovering lithium ions from gasfield brine with ultra low Li.mmd;/home/tnnrpolley21/Zotero/storage/DR4TCAUS/Wang et al. - 2026 - Dual-functional extraction system for recovering lithium ions from gasfield brine with ultra low Li.pdf;/home/tnnrpolley21/Zotero/storage/VH55U7KH/S000925092501766X.html}
}

@article{wangImprovementPRCPAEquation2018,
  title = {Improvement of the {{PR-CPA}} Equation of State for Modelling of Acid Gases Solubilities in Aqueous Alkanolamine Solutions},
