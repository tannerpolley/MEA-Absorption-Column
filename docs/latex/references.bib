@article{sanmamedExperimentalMethodologyPrecise2010,
  title = {Experimental Methodology for Precise Determination of Density of {{RTILs}} as a Function of Temperature and Pressure Using Vibrating Tube Densimeters},
  author = {Sanmamed, Y. A. and {Gonz{\'a}lez-Salgado}, D. and Troncoso, J. and Romani, L. and Baylaucq, A. and Boned, C.},
  year = 2010,
  month = apr,
  journal = {The Journal of Chemical Thermodynamics},
  volume = {42},
  number = {4},
  pages = {553--563},
  issn = {0021-9614},
  doi = {10.1016/j.jct.2009.11.014},
  urldate = {2026-08-18},
  abstract = {A specific calibration procedure that allows the accurate determination of densities of room temperature ionic liquids, RTILs, as a function of temperature and pressure using vibrating tube densimeters is presented. This methodology overcomes the problems of common calibration methods when they are used to determine the densities of high density and high viscosity fluids such as RTILs. The methodology is applied for the precise density determination of RTILs 1-ethyl-3-methylimidazolium tetrafluoroborate [Emim][BF4], 1-butyl-3-methylimidazolium tetrafluoroborate [Bmim][BF4], 1-hexyl-3-methylimidazolium tetrafluoroborate [Hmim][BF4], and 1-octyl-3-methylimidazolium tetrafluoroborate [Omim][BF4] in the temperature and pressure intervals (283.15 to 323.15)K and (0.1 to 60)MPa, respectively. The viscosities of these substances, needed for the estimation of the viscosity-induced errors, were estimated at the same conditions from the experimental measurements in the intervals (283.15 to 323.15)K and (0.1 to 14)MPa and from a specific extrapolation procedure. The uncertainty in the density measurements was estimated in \textpm 0.30kg{$\cdot$}m-3 which is an excellent value in the working intervals. The results of these RTILs have demonstrated that viscosity-induced errors are relevant and they must be taken into account for a precise density determination. Finally, an alternative tool for a simpler application of this procedure is presented.},
  keywords = {Calibration,Ionic liquids,Vibrating tube densimeter,Viscosity-induced errors},
  file = {/home/tnnrpolley21/Zotero/storage/N2AEYD2E/Sanmamed et al. - 2010 - Experimental methodology for precise determination of density of RTILs as a function of temperature.pdf;/home/tnnrpolley21/Zotero/storage/M7IMC3UE/S0021961409002900.html}
}

