@article{Yu2024,
  title = {Highly Efficient Lithium Extraction from Magnesium-Rich Brines with Ionic Liquid-Based Collaborative Extractants: {{Thermodynamics}} and Molecular Insights},
  author = {Yu, Gangqiang and Zhang, Xinhe and Hubach, Tobias and Chen, Biaohua and Held, Christoph},
  year = 2024,
  journal = {Chemical Engineering Science},
  volume = {286},
  number = {December 2023},
  pages = {119682},
