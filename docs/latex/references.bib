@article{mitsosDualExtremumPrinciple2007,
  title = {A Dual Extremum Principle in Thermodynamics},
  author = {Mitsos, Alexander and Barton, Paul I.},
  year = 2007,
  journal = {AIChE Journal},
  volume = {53},
  number = {8},
  pages = {2131--2147},
