@article{Rahimi2021,
  title = {Toward Smart Carbon Capture with Machine Learning},
  author = {Rahimi, Mohammad and Moosavi, Seyed Mohamad and Smit, Berend and Hatton, T. Alan},
  year = 2021,
  month = apr,
