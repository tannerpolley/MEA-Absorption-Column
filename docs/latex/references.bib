@article{jieun-chaEconomicEnvironmentalImplications2025,
  title = {Economic and Environmental Implications of Extractant Loss in Lithium Recovery from Waste Battery Effluent: {{A}} Comparative Study of {$\beta$}-Diketone-Based Extractants, {{HDBM}} and {{HBTA}}},
  shorttitle = {Economic and Environmental Implications of Extractant Loss in Lithium Recovery from Waste Battery Effluent},
  author = {{Jieun-Cha} and Vu, Thang Toan and {Junhyung-Seo} and {Seungu-Cho} and {Yeongeun-Choi} and {Daesung-Song}},
  year = 2025,
  month = mar,
  journal = {Journal of Water Process Engineering},
  volume = {71},
  pages = {107262},
  issn = {2214-7144},
  doi = {10.1016/j.jwpe.2025.107262},
  urldate = {2026-08-18},
  abstract = {The rapid growth of lithium-ion batteries (LiBs) promotes the lithium (Li) recovery from spent batteries. Solvent extraction is a typical hydrometallurgy method used to extract Li from the aqueous mixture by utilizing the selectivity of an organic extractant. This work investigates the economic and environmental implications of extractant loss in the Li recovery processes that can occur by the extractant's solubility in water and a high alkali environment. Our study focused on two {$\beta$}-diketone-based extractants: dibenzoylmethane (HDBM) and 4,4,4-trifluoro-1-phenyl-1,3-butanedione (HBTA), under optimized operating conditions. An analysis using a total organic carbon analyzer (TOC-L) revealed that the HBTA process incurs costs 3.42 times higher than the HDBM process due to significantly greater extractant loss. Specifically, HBTA experienced a loss of 1879~ppm across three extraction stages, compared to 435~ppm for HDBM, due to its hydrophilic fluorine substituent. For a process handling approximately 2.78 tons of battery scrap per hour, this disparity translates to an estimated annual cost difference of \$14.5 million in favor of HDBM. Sensitivity analysis further confirmed that, despite potential price fluctuations, HDBM consistently remains the more cost-effective option. The environmental impact assessment revealed that the carbon emissions of the HBTA process were 14~\% higher (1448 kgCO2eq/h) than those of the HDBM process, primarily due to extractant loss. These findings underscore the critical role of minimizing extractant loss in enhancing the economic and environmental viability of lithium recovery technologies.},
  keywords = {-Diketone,Economic and environmental analysis,Extractant loss,Solvent extraction,Waste battery recycling},
  file = {/home/tnnrpolley21/Zotero/storage/5P2Q2JAD/Jieun-Cha et al. - 2025 - Economic and environmental implications of extractant loss in lithium recovery from waste battery ef.pdf;/home/tnnrpolley21/Zotero/storage/TI9ZHU6A/S2214714425003344.html}
}

@article{jiLithiumExtractionCarbonaterich2024,
  title = {{Lithium extraction from carbonate-rich Salt Lake brine using HBTA/TBP system}},
  author = {Ji, Lian-Min and Shi, Dong and Peng, Xiao-Wu and Xie, Shao-Lei and Li, Jin-Feng and Zhang, Yu-Ze and Zhang, Li-Cheng and Niu, Yong and Chen, Gang and Li, Li-Juan},
  year = 2024,
  journal = {Rare Metals},
  volume = {43},
  number = {12},
  pages = {6717--6729},
  issn = {1867-7185},
  doi = {10.1007/s12598-024-02760-3},
  urldate = {2026-08-18},
  abstract = {AbstractChina's salt lakes hold significant lithium reserves, yet the development of low-concentration lithium resources from the carbonate brines in Tibet is a pressing matter. Alkyl {$\beta$}-diketones extractants are capable of efficiently extracting lithium from alkaline solutions using an extraction method, but its optimized extraction prerequisite is an extreme alkaline solution with higher pH. This research introduces a process for the effective extraction and separation of lithium and sodium from the carbonate brine of Jieze Caka Salt Lake, utilizing trifluorinated {$\beta$}-biketone HBTA (4,4,4-trifluoro-1-phenyl-1,3-butanedione)--TBP (tributyl phosphate)/kerosene system. A three-stage extraction yielded 98.06\% of Li+ and 1.69\% of Na+ from the initial brine with a lower pH of 8.961 and a separation factor ({$\beta$}Li/Na) of 2948. The simplified process was then implemented using organic direct recycling without regeneration and scrubbing raffinate reflux for a total of 23 cycles, thereby demonstrating the exceptional effectiveness and stability of this system. The resulting lithium-rich stripping solution, with the Li/Na mass ratio amplified by 747 times, underwent further magnesium removal and precipitation using sodium carbonate to yield a high-purity lithium carbonate product of 99.50\%. This study offers a novel approach and technology for the efficient separation of lithium ion directly from a partial-neutral carbonate salt lake with a high Na/Li ratio and low lithium concentration.},
  langid = {chinese},
  keywords = {Carbonated salt lake,Diketone extractant,Lithium,Solvent extraction,Tibet brine},
  file = {/home/tnnrpolley21/Zotero/storage/IRCTQK2Y/Ji et al. - 2024 - Lithium extraction from carbonate-rich Salt Lake brine using HBTATBP system.pdf;/home/tnnrpolley21/Zotero/storage/CZNAXJMN/s12598-024-02760-3.html}
}

@article{jiModelingDensityIonic2016,
  title = {Modeling the Density of Ionic Liquids with {{ePC-SAFT}}},
  author = {Ji, Xiaoyan and Held, Christoph},
  year = 2016,
  month = feb,
  journal = {Fluid Phase Equilibria},
  volume = {410},
  pages = {9--22},
  issn = {0378-3812},
  doi = {10.1016/j.fluid.2015.11.014},
  urldate = {2026-08-18},
  abstract = {ePC-SAFT was used to model the densities of ionic liquids (ILs) up to high pressures and temperatures. The ILs under consideration contained one of the IL-cations [Cnmim]+, [Cnpy]+, [Cnmpy]+, [Cnmpyr]+ or [THTDP]+, and one of the IL-anions [Tf2N]-, [PF6]-, [BF4]-, [tfo]-, [DCA]-, [SCN]-, [C1SO4]-, [C2SO4]-, [eFAP]-, Cl-, [Ac]- or Br-, respectively. Within the ePC-SAFT framework, IL-ion specific parameters were applied that are valid independent of the IL they are part of. Each IL-ion was modeled as a non-spherical species exerting repulsive, dispersive and Coulomb forces. The ePC-SAFT parameters for [Cnmim]+ (n~=~2, 4, 6 and 8), [Tf2N]-, [PF6]-, and [BF4]- were taken from our previous work (Fluid Phase Equilibria 2012 (335) 64--73). Based on these parameters, all parameters of the other IL-ions were fitted to experimental density of pure ILs up to high pressures in a broad temperature range. Being provided with ion-specific and linearly molecular-weight-dependent parameters, ePC-SAFT allows reliably representing/predicting pure-IL and mixed-IL density up to high pressures.},
  keywords = {Density,ePC-SAFT,Ionic liquids},
  file = {/home/tnnrpolley21/Zotero/storage/JU7A5BSG/Ji and Held - 2016 - Modeling the density of ionic liquids with ePC-SAFT.pdf;/home/tnnrpolley21/Zotero/storage/S7EF4CLJ/S0378381215302193.html}
}

@article{jiModelingImidazoliumbasedIonic2012,
  title = {Modeling Imidazolium-Based Ionic Liquids with {{ePC-SAFT}}},
  author = {Ji, Xiaoyan and Held, Christoph and Sadowski, Gabriele},
  year = 2012,
  month = dec,
  journal = {Fluid Phase Equilibria},
  volume = {335},
  pages = {64--73},
  issn = {0378-3812},
  doi = {10.1016/j.fluid.2012.05.029},
  urldate = {2026-08-18},
  abstract = {ePC-SAFT was used to investigate the density and gas solubilities in imidazolium-based ionic liquids (ILs) applying different modeling strategies. The ion-based strategy including a Debye--H\"uckel Helmholtz-energy term to represent the ionic interactions describes the experimental data best. For this strategy, the IL was considered to be completely dissociated into a cation and an anion. Each ion was modeled as non-spherical species exerting repulsive, dispersive, and Coulomb forces. A set of ePC-SAFT parameters for seven ions was obtained by fitting to reliable density data of pure ILs up to 1000bar with a fitting error of 0.14\% on average. The model can be used to quantitatively extrapolate the density of pure ILs at temperatures from 283 to 473K and pressures up to 3000bar. Moreover, this strategy allows predicting CO2 solubilities in ILs between 293 and 450K and up to 950bar. Applying the same set of IL parameters, the much lower solubility of CH4 compared to CO2 can also be predicted with ePC-SAFT.},
  keywords = {CH,CO,Equation of state,Gas solubility,Ionic liquids,PC-SAFT},
  file = {/home/tnnrpolley21/Zotero/storage/7HDJAGWB/Ji et al. - 2012 - Modeling imidazolium-based ionic liquids with ePC-SAFT.pdf;/home/tnnrpolley21/Zotero/storage/SIZBAGEM/S0378381212003846.html}
}

@article{Jiru2012,
  title = {Measurements and Correlation of Physical Solubility of Carbon Dioxide in (Monoethanolamine + Water) by a Modified Technique},
  author = {Jiru, Ying and Eimer, Dag A. and Wenjuan, Yi},
  year = 2012,
