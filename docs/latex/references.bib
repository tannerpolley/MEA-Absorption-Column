@article{Ahmed2018,
  title = {Modeling of Mixed-Solvent Electrolyte Systems},
  author = {Ahmed, Saifuddin and Ferrando, Nicolas and de Hemptinne, Jean Charles and Simonin, Jean Pierre and Bernard, Olivier and Baudouin, Olivier},
  year = 2018,
  journal = {Fluid Phase Equilibria},
  volume = {459},
  pages = {138--157},
  publisher = {Elsevier Ltd},
  issn = {03783812},
  doi = {10.1016/j.fluid.2017.12.002},
  abstract = {Models for mixed-solvent strong electrolytes, using an equation of state (EoS) are reviewed in this work. Through the example of ePPC-SAFT (that includes a Born term and ionic association), the meaning and the effect of each contribution to the solvation energy and the mean ionic activity coefficient are investigated. The importance of the dielectric constant is critically reviewed, with a focus on the use of a salt-concentration dependent function. The parameterization is performed using two adjustable parameters for each ion: a minimum approach distance ({$\sigma$}MSA) and an association energy ({$\varepsilon$}AB). These two parameters are optimized by fitting experimental activity coefficient and liquid density data, for all alkali halide salts simultaneously, in the range 298 K--423 K. The model is subsequently tested on a large number of available experimental data, including salting out of Methane/Ethane/CO2/H2S. In all cases the deviations in bubble pressures were below 20\% AADP. Predictions of vapor-liquid equilibrium of mixed solvent electrolyte systems containing methanol, ethanol are also made where deviations in bubble pressures were found to be below 10\% (AADP).},
  keywords = {Dielectric constant,Electrolytes,ePPC-SAFT,Mixed solvents,Salting-out},
  file = {/home/tnnrpolley21/Zotero/storage/EUVNYKHY/Ahmed et al. - 2018 - Modeling of mixed-solvent electrolyte systems.pdf}
}

@article{Akula2021,
  title = {Model {{Development}}, {{Validation}}, and {{Optimization}} of an {{MEA-Based Post-Combustion CO2Capture Process}} under {{Part-Load}} and {{Variable Capture Operations}}},
  author = {Akula, Paul and Eslick, John and Bhattacharyya, Debangsu and Miller, David C.},
  year = 2021,
  journal = {Industrial and Engineering Chemistry Research},
  volume = {60},
  number = {14},
  pages = {5176--5193},
  issn = {15205045},
  doi = {10.1021/acs.iecr.0c05035},
  abstract = {Existing power plants are frequently load-following due to increasing penetration of the renewables into the grid. For power plants integrated with CO2 capture, optimal operation of the capture unit at part-load and variable capture conditions can be exploited to reduce the operating costs. This paper presents insights into the performance of a reference monoethanolamine (MEA)-based post-combustion CO2 capture unit under steady-state part-load and variable capture operations. A rigorous plant-wide model for the capture unit is developed in the Institute for Design of Advanced Energy Systems computational platform. The contactor model is validated with the data from a wetted wall column (WWC) and two pilot plants. The plant-wide model is used for steady-state optimization under part-load operations and variable capture rates using flue gas similar to pulverized coal and natural gas-combined cycle power plants. Analysis on the performance of the reference rich/lean amine heat exchanger shows that the hot-end temperature approach can considerably vary under part-load operations for a given heat exchanger area. The study shows that if the plant is not optimally operated under part-load and variable capture operations, there can be a high penalty depending on the deviation of the liquid/gas flowrate with respect to its optimal value. This study shows that the optimal operation of an existing capture unit is crucial for minimizing the energy penalty under part-load and variable capture operations.},
  file = {/home/tnnrpolley21/Zotero/storage/2GKGSK7B/Akula et al. - 2021 - Model Development, Validation, and Optimization of an MEA-Based Post-Combustion CO2Capture Process u.pdf;/home/tnnrpolley21/Zotero/storage/L5R92KNP/Akula - Supplemental - 2021 - Model Development, Validation, and Optimization of an MEA-Based Post-Combustion CO2 Capture Process under Part-Load and Variable Capture Operations.pdf;/home/tnnrpolley21/Zotero/storage/LLHNM9BB/Akula - Supplemental - 2021 - Model Development, Validation, and Optimization of an MEA-Based Post-Combustion CO2 Capture Process under Part-Load and Variable Capture Operations.mmd}
}

