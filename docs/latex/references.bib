  journal = {Next Chemical Engineering},
  volume = {2},
  pages = {100018},
  issn = {3050-7243},
  doi = {10.1016/j.nxcen.2025.100018},
  urldate = {2026-05-09},
  abstract = {Process simulators are essential for training engineers in petrochemical, biochemical, and chemical industries, covering design, thermodynamics, and process integration. However, high licensing costs often limit access to commercial simulators, especially in resource-constrained institutions. This study compares Aspen HYSYS, DWSim, and COCO simulators in modeling ethane dehydrogenation, focusing on thermodynamic accuracy, mass and energy balances, and process performance. Results show that Aspen HYSYS and COCO, both using comprehensive thermodynamic models, closely match experimental data, while DWSim shows wider deviations. Temperature and pressure strongly influence ethane-to-ethylene conversion, consistent with experimental trends. COCO demonstrates comparable performance to the commercial tool, confirming its reliability for educational and research applications. The study promotes ethical software use and advocates adopting affordable freeware simulators to enhance accessibility, sustainability, and training quality in economically challenged regions.},
  keywords = {Chemical engineering education,Ethics,Modeling,Process design,Simulation},
  file = {/home/tnnrpolley21/Zotero/storage/AV9ZE24W/Oyegoke - 2026 - Thermodynamic insights into ethane dehydrogenation An examination of open-source process simulator.pdf;/home/tnnrpolley21/Zotero/storage/56UZCBLM/S305072432500018X.html}
}

@article{Oyen2021,
  title = {Interface {{Mass Transfer}} in {{Reactive Bubbly Flow}}: {{A Rigorous Phase Equilibrium-Based Approach}}},
  author = {{\O}yen, S. B. and Jakobsen, H. A. and {Haug-Warberg}, T. and Solsvik, J.},
  year = 2021,
  month = dec,
  journal = {Industrial and Engineering Chemistry Research},
  volume = {60},
  number = {48},
  pages = {17705--17732},
  publisher = {American Chemical Society},
  issn = {15205045},
  doi = {10.1021/acs.iecr.1c03131},
  abstract = {In this work, the driving force of interfacial mass transfer is modeled as deviation from the gas-liquid equilibrium, which by assumption is thought to exist at the interface separating the gas and liquid phases. The proposed mass transfer model provides a flexible framework where the phase equilibrium description in the driving force can be substituted without difficulties, allowing the mass transfer modeling of distillation, absorption/stripping, extraction, evaporation, and condensation to be based on a thermodynamically consistent phase equilibrium formulation. Phase equilibrium by the Soave-Redlich-Kwong equation of state (SRK-EoS) is in this work compared to the results of the classical Henry's law approach. The new model formulation can predict mass transfer of the solvent, which Henry's law cannot. The mass transfer models were evaluated by simulating a single-cell protein process operated in a bubble column bioreactor, and the solubilities computed from the SRK-EoS and Henry's law were in qualitative agreement, albeit in quantitative disagreement. At the reactor inlet, the solubility of O2and CH4was 150\% higher with the SRK-EoS than with Henry's law. Furthermore, the SRK-EoS was computationally more expensive and spent 10\% more time than Henry's law.},
  file = {/home/tnnrpolley21/Zotero/storage/28WZCGAJ/Øyen et al. - 2021 - Interface Mass Transfer in Reactive Bubbly Flow A Rigorous Phase Equilibrium-Based Approach.pdf}
}

