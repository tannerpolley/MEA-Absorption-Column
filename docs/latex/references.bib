  title = {Use of {{Flow Calorimetry}} for {{Determining Enthalpies}} of {{Absorption}} and the {{Solubility}} of {{CO2}} in {{Aqueous Monoethanolamine Solutions}}},
  author = {Mathonat, C. and Majer, V. and Mather, A. E. and Grolier, J.-P. E.},
  year = 1998,
  month = sep,
  journal = {Ind. Eng. Chem. Res.},
  volume = {37},
