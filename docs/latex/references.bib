  abstract = {A cascade solvent extraction process was proposed for recovering Li+ from concentrated seawater. First, solid (NH4)2CO3 and NaOH were used to successfully remove Ca2+ and Mg2+ as carbonate/hydroxide. Subsequently, by using 4,4,4-trifluoro-1-phenylbutane-1,3-dione (HBTA) and 2-octanone as the extractant and diluent, a single extraction-evaporation process was conducted to preliminarily enrich Li+ in the brine, reducing the Na/Li mass ratio from 47,500 to 142. Secondary extraction of the preliminarily enriched Li+ solution was conducted using the same extraction system. After extraction, the loaded organic phase was washed with a mixed solution of NH4Cl and LiCl, achieving a Na+ washing efficiency of 99.5\% without Li+ loss. Finally, the stripping process with HCl solution under high phase ratio achieved a 98\% recovery efficiency, yielding a lithium-rich solution with a lithium concentration of 3.14~\texttimes ~103~mg/L and a Na/Li mass ratio of 0.01. Mechanism studies confirmed that for {$\beta$}-diketone extractants like HBTA, the binding affinity for metal ions in alkaline brine followed the sequence Li+~{$>~$}Na+~{$>~$}K+. This process not only significantly reduced the Na/Li mass ratio in concentrated seawater from 47,500 to 0.01, but also achieved nearly 1500-fold cumulative concentration of Li+, providing a novel technical pathway for lithium extraction from concentrated seawater.},
  keywords = {Cascade solvent extraction,Concentrated seawater,Extraction mechanism,Extraction-evaporation process,Na/Li mass ratio},
  file = {/home/tnnrpolley21/Zotero/storage/PQCGP8CD/Han et al. - 2026 - Highly selective recovery of lithium ions from concentrated seawater using a stepwise precipitation,.pdf;/home/tnnrpolley21/Zotero/storage/PBKCK83S/S0304386X26002057.html}
}

