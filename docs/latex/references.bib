}

@article{Held2009,
  title = {Modeling Aqueous Electrolyte Solutions. {{Part}} 2. {{Weak}} Electrolytes},
  author = {Held, Christoph and Sadowski, Gabriele},
  year = 2009,
  journal = {Fluid Phase Equilibria},
  volume = {279},
