@article{Coatleven2022,
  title = {A Successive Substitution Approach with Embedded Phase Stability for Simultaneous Chemical and Phase Equilibrium Calculations},
  author = {Coatl{\'e}ven, Julien and Michel, Anthony},
  year = 2022,
  month = dec,
  journal = {Computers \& Chemical Engineering},
  volume = {168},
  pages = {108041},
  issn = {0098-1354},
  doi = {10.1016/j.compchemeng.2022.108041},
  urldate = {2026-05-24},
  abstract = {We propose a nested Gibbs energy minimization method for simultaneous chemical and phase equilibrium calculations, relying on a new formulation of the Lagrange multiplier based inner sub-problem with fixed activity coefficients. Using a sufficient condition for global optimality with fixed activity coefficients equivalent in this case to the tangent plane distance criterion, we describe two equivalent algorithms, a combinatorial and a complementarity based one, allowing to robustly solve this new sub-problem always incorporating all phases. The outer-loop of the global successive substitution reactive flash then only consists in updating the values of the activity coefficients from the non necessarily normalized species fractions for all phases calculated by the inner sub-problem. Numerical experiments from the literature illustrate the correct behavior of the proposed approach.},
  keywords = {Flash calculations,Gibbs energy minimization,Reactive equilibrium,Successive substitution},
  file = {/home/tnnrpolley21/Zotero/storage/X77J63ZP/Coatléven and Michel - 2022 - A successive substitution approach with embedded phase stability for simultaneous chemical and phase.pdf;/home/tnnrpolley21/Zotero/storage/3QASIBQF/S0098135422003738.html}
}

