@article{idrisSpeciationMEACO2Adducts2014,
  title = {Speciation of {{MEA-CO2 Adducts}} at {{Equilibrium Using Raman Spectroscopy}}},
  author = {Idris, Zulkifli and Jens, Klaus J. and Eimer, Dag A.},
  year = 2014,
  month = jan,
  journal = {Energy Procedia},
  series = {12th {{International Conference}} on {{Greenhouse Gas Control Technologies}}, {{GHGT-12}}},
  volume = {63},
  pages = {1424--1431},
  issn = {1876-6102},
  doi = {10.1016/j.egypro.2014.11.152},
  urldate = {2026-08-24},
  abstract = {Among a number of initiatives proposed for capturing CO2, the post-combustion technology is attractive as it offers fewer problems to be dealt with and does not require massive reconstruction of the existing power plants, thus reducing the economic penalty. In this paper, we present new vapor liquid equilibrium data for the solubility of CO2 in MEA at 30, 40 and 50 wt\% at a temperature of 40 oC. The data are compared with establish data obtained from literature and showed a close agreement. The ability of Raman spectroscopy to quantify the species present during the reaction is explored in this paper. First, calibration plots of carbonate, bicarbonate and carbamate are constructed based on the Raman active bands at 1065 cm-1, 1019 cm-1 and 1034 cm-1, respectively. A detailed analysis of the species present during the reaction of aqueous MEA and CO2 using Raman spectroscopy is discussed in this paper.},
  keywords = {CO solubility,Ethanolamine,Raman spectroscopy},
  file = {/home/tnnrpolley21/Zotero/storage/5W37W7C7/Idris et al. - 2014 - Speciation of MEA-CO2 Adducts at Equilibrium Using Raman Spectroscopy.pdf;/home/tnnrpolley21/Zotero/storage/AF5RP4X8/S1876610214019675.html}
}

