@article{Golabiazar2014,
  title = {Vapor {{Pressure Osmometry Determination}} of the {{Osmotic}} and {{Activity Coefficients}} of {{Dilute Aqueous Solutions}} of {{Symmetrical Tetraalkyl Ammonium Halides}} at 308.15 {{K}}},
