@article{Maghsoodloo2025,
  title = {Thermodynamic {{Modeling}} of {{Mixed Solvent Electrolyte Solutions}}: {{Challenges}} and {{Practical Guide}}},
  shorttitle = {Thermodynamic {{Modeling}} of {{Mixed Solvent Electrolyte Solutions}}},
  author = {Maghsoodloo, Saheb and Ngo, Tri Dat and {de Hemptinne}, Jean-Charles and Moine, Edouard and Wang, Shu and {Maribo-Mogensen}, Bjorn and Altuntepe, Emrah and {Asensio-Delgado}, Salvador and Peper, Stephanie and {Gonz{\'a}lez de Castilla}, Andr{\'e}s and Ferrari, Pascal and Steimers, Ellen and Kuitunen, Susanna},
  year = 2025,
  month = nov,
  journal = {J. Chem. Eng. Data},
  volume = {70},
  number = {11},
  pages = {4331--4350},
  publisher = {American Chemical Society},
  issn = {0021-9568},
  doi = {10.1021/acs.jced.5c00412},
  urldate = {2026-05-24},
  abstract = {Electrolyte systems are characterized by their (i) strong nonideal behavior requiring advanced thermodynamic models, (ii) reactive components necessitating knowledge of formation properties, and (iii) multiphase nature, which demands robust reactive algorithms. These complexities are crucial in industrial applications, leading to the creation of the Joint Industry Project (JIP) EleTher, which aims to promote further academic exploration and provide recommendations for parametrizing such systems. To better understand interactions in electrolyte systems, the study focuses on quaternary systems comprising water, an acid, a base, and a cosolvent. This approach isolates pH effects from the dielectric constant influences. Due to limited data, only ternary subsystems were analyzed. The study evaluated the accuracy of three approaches: full dissociation (FD), no dissociation (ND), and partial dissociation (PD). While FD and ND approaches performed adequately for vapor--liquid equilibrium, they failed when speciation became significant. The PD approach, though more accurate, revealed challenges with parameter optimization as multiple local minima resulted in varying species distributions. A hybrid approach combining FD, ND, and PD models is recommended for achieving the most physically meaningful results. The study utilized the eNRTL method CPA equation of state within in-house tools (Carnot and ATOUT) to conduct the analysis.},
  file = {/home/tnnrpolley21/Zotero/storage/MMRNBNT9/Maghsoodloo et al. - 2025 - Thermodynamic Modeling of Mixed Solvent Electrolyte Solutions Challenges and Practical Guide.pdf}
}

