}

@article{Liu1999,
  title = {Representing Vapor-Liquid Equilibrium for an Aqueous {{MEA-CO2}} System Using the Electrolyte Nonrandom-Two-Liquid Model},
  author = {Liu, Yunda and Zhang, Luzheng and Watanasiri, Suphat},
