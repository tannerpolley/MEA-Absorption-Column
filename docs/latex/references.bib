  doi = {10.1021/acs.iecr.4c03496},
  urldate = {2026-05-08},
  abstract = {Lithium is a strategic element for energy storage. Extraction from surface water is a promising method for the purification of lithium. Synthetic model brines containing lithium and sodium ions were prepared for extraction experiments. A hydrophobic deep eutectic solvent (HDES) was synthesized using tetrabutylammonium chloride (TBAC) as the hydrogen bond acceptor (HBA) and decanoic acid (DA) as the hydrogen bond donor (HBD). Trioctylphosphine oxide (TOPO) was chosen as the coextractant. Fourier transform infrared (FT-IR) and 1H NMR analyses confirmed the physical interactions between the HBD and HBA. Response surface methodology was used to optimize the operational parameters for lithium extraction percentage and selectivity. The organic phase containing TBAC(1)/DA(2) and 10 wt \% of TOPO at T = 23.0 {$^\circ$}C and pH = 10.4 demonstrated the highest extraction performance. The optimized point yielded a selectivity of 4.41 and an extraction efficiency of 48.57\% for one stage of extraction. The ion exchange reaction between lithium and hydrogen in the deep eutectic solvent (DES) phase was confirmed by FT-IR spectroscopy. Five regeneration cycles revealed that the organic phase remained stable after the third cycle. The extraction efficiency of lithium ions from a model brine with the same composition as that of Iran's sources was 51.63\% compared to those of sodium, potassium, magnesium, and calcium ions, which were 9.97, 3.11, 4.38, and 2.29\%, respectively. The HDES synthesized in this study is cost-effective and biodegradable compared to other HDESs reported in the literature.},
  file = {/home/tnnrpolley21/Zotero/storage/AY2C8IID/Supporting Infomation - Rezaee et al. - 2025 - Application of Response Surface Methodology for Selective Extraction of Lithium Using a Hydrophobic.md;/home/tnnrpolley21/Zotero/storage/I5KDHXGC/Rezaee et al. - 2025 - Application of Response Surface Methodology for Selective Extraction of Lithium Using a Hydrophobic.pdf}
}

@article{Rezaee2026,
  title = {Thermodynamic Modeling of Lithium Extraction from Synthetic Brine Using Deep Eutectic Solvents: {{A PC-SAFT}} Approach},
  shorttitle = {Thermodynamic Modeling of Lithium Extraction from Synthetic Brine Using Deep Eutectic Solvents},
  author = {Rezaee, Mehran and Feyzi, Farzaneh and Miri, Rohaldin},
  year = 2026,
  month = oct,
  journal = {Fluid Phase Equilibria},
  volume = {609},
  pages = {114737},
  issn = {0378-3812},
  doi = {10.1016/j.fluid.2026.114737},
  urldate = {2026-05-07},
  abstract = {Renewable energy sources are essential for mitigating global warming, with lithium-ion batteries serving as a key technology for effective energy storage in electric vehicles and grid-scale applications. This research investigates the thermodynamic modeling of lithium extraction from synthetic brine using a hydrophobic deep eutectic solvent (DES). The extraction process involves ion exchange between aqueous ions (Li{$^+$}, Na{$^+$}) and an organic phase containing DES (tetrabutylammonium chloride (TBAC) and Decanoic acid (DA) with 1:2 molar ratio) and Trioctylphosphine oxide (TOPO). Equilibrium reaction constants were calculated using Joback-Reid and Mostafa group contribution methods. Equilibrium calculations were performed using PC-SAFT and ePC-SAFT equations of state (EOS) for the organic phase and aqueous phase, respectively. EOS parameters for the DES and TOPO were derived from experimental density measurement data. Binary interaction parameters of the EOS, in the organic phase, were fitted to experimental equilibrium data. The average absolute relative deviation (AARD) for lithium extraction percentage and selectivity over sodium were 7.89 \% and 8.63 \%, respectively.},
  keywords = {Deep eutectic solvents,Density measurement,Lithium extraction,PC-SAFT equation of state,Thermodynamic modeling},
  file = {/home/tnnrpolley21/Zotero/storage/C6FBS8CS/Rezaee et al. - 2026 - Thermodynamic modeling of lithium extraction from synthetic brine using deep eutectic solvents A PC.mmd;/home/tnnrpolley21/Zotero/storage/TSKR6LVS/Rezaee et al. - 2026 - Thermodynamic modeling of lithium extraction from synthetic brine using deep eutectic solvents A PC.pdf;/home/tnnrpolley21/Zotero/storage/VLUUY8FI/Supporting Infomation - Rezaee et al. - 2026 - Thermodynamic modeling of lithium extraction from synthetic brine using deep eutectic solvents A PC.md}
}

