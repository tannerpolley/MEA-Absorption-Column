@article{Cleeton2020,
  title = {Competitive {{H2S--CO2}} Absorption in Reactive Aqueous Methyldiethanolamine Solution: {{Prediction}} with {{ePC-SAFT}}},
  author = {Cleeton, Conor and Kvam, Odin and Rea, Riccardo and Sarkisov, Lev and De Angelis, Maria Grazia},
  year = 2020,
  month = may,
  journal = {Fluid Phase Equilibria},
  volume = {511},
  publisher = {Elsevier B.V.},
  issn = {03783812},
  doi = {10.1016/j.fluid.2019.112453},
  abstract = {Reactive absorption of CO2 and H2S in aqueous methyldiethanolamine (MDEA) solutions is considered within the ePC-SAFT equation of state. We demonstrate that ePC-SAFT can be employed in a predictive manner without regression of additional temperature-correlated terms. Mixed system predictions are tested using a consistent set experimental data covering a wide range of temperatures (313 K--413 K), partial pressures (0.001 kPa--1000 kPa), and MDEA mass fractions (0.05--wMDEA 0.75 wMDEA). Predicted partial pressures for acid gas absorption show good agreement for low MDEA fractions (wMDEA {$<$} 0.5). Absorption selectivity in binary H2S + CO2 absorption is correctly predicted, with absolute average deviations of 57.18\% and 79.32\% for partial pressures of CO2 and H2S. We identify a significant deterioration in ePC-SAFT predictive power for the high-MDEA regime (wMDEA {$>$} 0.5), likely originating from underlying assumptions in the Debye-H\"uckel electrolyte free energy treatment and representation of ionic species.},
  keywords = {Absorption,Amine,CO2 capture,Equation of state,priority:key,Solution},
  file = {/home/tnnrpolley21/Zotero/storage/9Z3P9NXX/Cleeton - 2019 - Competitive H2S e CO2 absorption in reactive aqueous MDEA - Prediction with ePC-SAFT.pdf;/home/tnnrpolley21/Zotero/storage/IEBNHBR2/Cleeton et al.md}
}

