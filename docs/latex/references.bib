  doi = {10.1002/kin.20375},
  urldate = {2026-08-24},
  abstract = {The process of pure carbon dioxide absorption is analyzed in aqueous solutions of N-methyldiethanolamine (MDEA). The experiments were made in a stirred tank reactor with a plane and known interface area. The variables considered were the MDEA concentration within the range 0.1--3.0 M and the temperature in the interval 288--313 K. From the results, we deduce that the process takes place under isothermal conditions and moderately fast regime, with second-order kinetics. We determined a reaction order of one with respect to the amine, and an expression for the kinetic constant valid throughout the entire range of temperatures and concentrations assayed ln k = 22.4 - 6243.5/T. \copyright{} 2008 Wiley Periodicals, Inc. Int J Chem Kinet 41: 204--214, 2009},
