  file = {/home/tnnrpolley21/Zotero/storage/IH6KDWG6/Shojaeian and Haghtalab - 2013 - Solubility and density of carbon dioxide in different aqueous alkanolamine solutions blended with 1-.pdf;/home/tnnrpolley21/Zotero/storage/IY6BQWME/S0167732213002481.html}
}

@article{Silva2023,
  title = {How to Account for the Concentration Dependency of Relative Permittivity in the {{Debye}}--{{H\"uckel}} and {{Born}} Equations},
  author = {Silva, Gabriel M. and Liang, Xiaodong and Kontogeorgis, Georgios M.},
  year = 2023,
